---
import Base from '../layouts/Base.astro';
import manifest from '../data/generated/manifest.json';
import { fmtInt } from '../lib/format.js';

const places = manifest.places ?? [];
const placeCount = places.length;

// Pre-compute the state list for the per-state browse so the page doesn't
// have to do it in JS. Each entry: { name, slug, count }.
const stateCounts = {};
for (const p of places) {
  if (!stateCounts[p.state]) stateCounts[p.state] = { name: p.state, slug: p.state_slug, count: 0 };
  stateCounts[p.state].count++;
}
const stateList = Object.values(stateCounts).sort((a, b) => a.name.localeCompare(b.name));

// Vintage label: places.json carries it as e.g. "ACS 5-year 2023".
const vintageLabel = manifest.places_vintage ?? 'ACS 5-year estimates';
const minPop = manifest.places_min_population ?? 10000;
---

<Base title="Cities & towns — housinganalytics.org"
      description="Housing profiles for U.S. cities and towns, drawn from the American Community Survey at Census place geography.">

  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">Cities &amp; towns</p>
      <h1>Housing data for U.S. cities and towns.</h1>
      <p class="hero__lede">
        Sub-county profiles drawn directly from the Census Data API at the place geography level.
        {fmtInt(placeCount)} cities, towns, and CDPs with population ≥ {fmtInt(minPop)} ·
        {vintageLabel}.
      </p>

      <form class="search" role="search" data-place-search>
        <input
          type="search"
          name="q"
          placeholder="Search a city — e.g. Atlanta, Savannah, Macon…"
          autocomplete="off"
          aria-label="Search cities and towns" />
        <ul class="search__results" hidden></ul>
      </form>
      <p class="search__hint muted">
        Looking for a county instead? <a href="/counties">Open the county search →</a>
      </p>
    </div>
  </section>

  <section class="container">
    <h2>What's in a city profile</h2>
    <p class="section-lede muted">
      Each city profile uses the same three sections as the county profiles — Community Profile,
      Residential Market Analysis, and Workforce Housing Needs Assessment — adapted to data
      available at sub-county geography.
    </p>

    <ul class="feature-list">
      <li class="feature">
        <p class="feature__eyebrow">City profiles</p>
        <h3><a href="#" data-feature-link="cities">A full housing profile for any of {fmtInt(placeCount)} cities and towns</a></h3>
        <p>
          Demographics, housing stock, tenure, costs, rent and value distributions, cost burden,
          and the same parametric affordability calculator you'll find on the county pages —
          all at the city geography.
        </p>
        <p class="feature__hint muted">Use the search box at the top of the page.</p>
      </li>

      <li class="feature">
        <p class="feature__eyebrow">HUD AMI inherited</p>
        <h3>Workforce housing benchmarks from the parent county</h3>
        <p>
          HUD publishes Area Median Income at county / MSA level. Each city profile inherits the
          HUD AMI table from its parent county, so the 80% / 100% / 120% workforce ranges line up
          with the way analysts already think about regional affordability.
        </p>
        <p class="feature__hint muted">Disclosed on the profile page.</p>
      </li>

      <li class="feature">
        <p class="feature__eyebrow">Not on city pages</p>
        <h3>BLS QCEW and OEWS sections</h3>
        <p>
          Industry employment (QCEW) and occupation wages (OEWS) are published at county / MSA
          geography only. To see them, open the parent county profile — the city profile shows
          the parent-county FIPS in its methodology footer.
        </p>
        <p class="feature__hint"><a href="/counties">Search a county →</a></p>
      </li>
    </ul>

    <h2 class="states-h2">Browse by state</h2>
    <p class="section-lede muted">
      Currently {fmtInt(placeCount)} cities across {fmtInt(stateList.length)} {stateList.length === 1 ? 'state' : 'states'}.
      More states will be added as the city dataset expands.
    </p>
    <ul class="state-list">
      {stateList.map(s => (
        <li>
          <a href={`#state-${s.slug}`} data-state-jump={s.slug}>
            {s.name} <span class="muted">({s.count})</span>
          </a>
        </li>
      ))}
    </ul>

    {stateList.map(s => (
      <section class="state-section" id={`state-${s.slug}`}>
        <h3>{s.name}</h3>
        <ul class="city-list">
          {places
            .filter(p => p.state_slug === s.slug)
            .sort((a, b) => (b.population_total ?? 0) - (a.population_total ?? 0))
            .map(p => (
              <li>
                <a href={`/place/${p.state_slug}/${p.slug}`}>
                  {p.name}
                  <span class="muted">{fmtInt(p.population_total)}</span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))}

    <p class="coming-soon muted">
      <strong><a href="/city-rankings">City rankings are live</a></strong> — sort every city on any
      metric, including the Housing Stress Index. Coming next: city compare (2–6 cities side by side)
      and an option to lower the population threshold below 10,000.
    </p>
  </section>
</Base>

<script type="module" define:vars={{ places }}>
  // Lightweight typeahead — cities only.
  const form  = document.querySelector('[data-place-search]');
  const input = form.querySelector('input');
  const out   = form.querySelector('.search__results');

  function render(matches) {
    if (!matches.length) { out.hidden = true; out.innerHTML = ''; return; }
    out.hidden = false;
    out.innerHTML = matches.slice(0, 10).map(p => `
      <li><a href="/place/${p.state_slug}/${p.slug}">
        <span>${p.name}</span>
        <span class="muted">${p.state}</span>
      </a></li>
    `).join('');
  }

  // Rank: exact name-prefix > name substring > state-prefix > state substring.
  function score(p, q) {
    const name = p.name.toLowerCase();
    const state = p.state.toLowerCase();
    if (name.startsWith(q)) return 0;
    if (name.includes(q))   return 1;
    if (state.startsWith(q)) return 2;
    if (state.includes(q))   return 3;
    return 9;
  }

  input.addEventListener('input', e => {
    const q = e.target.value.trim().toLowerCase();
    if (q.length < 2) return render([]);
    const matches = places
      .map(p => ({ p, s: score(p, q) }))
      .filter(x => x.s < 9)
      .sort((a, b) => a.s - b.s || a.p.name.localeCompare(b.p.name))
      .map(x => x.p);
    render(matches);
  });

  input.addEventListener('blur', () => setTimeout(() => render([]), 200));

  // Feature card headline scrolls back to search box and focuses it.
  document.querySelectorAll('[data-feature-link="cities"]').forEach(el => {
    el.addEventListener('click', e => {
      e.preventDefault();
      input.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => input.focus(), 350);
    });
  });
</script>

<style>
  /* Hero + search reuse the same look as the homepage. Kept in this file so the
     page is fully self-contained — matches how other pages on the site are
     organized today. */
  .hero {
    background: var(--bg-section);
    padding: var(--space-9) 0 var(--space-7);
    border-bottom: 1px solid var(--border-soft);
  }
  .hero h1 { max-width: 20ch; margin-bottom: var(--space-4); }
  .hero__lede { max-width: 60ch; font-size: var(--fs-md); color: var(--text-muted); margin-bottom: var(--space-6); }

  .search { position: relative; max-width: 560px; }
  .search input {
    width: 100%;
    padding: var(--space-4) var(--space-5);
    font-size: var(--fs-md);
    font-family: inherit;
    border: 2px solid var(--color-navy);
    border-radius: var(--radius-md);
    background: var(--bg-page);
    box-shadow: var(--shadow-soft);
  }
  .search input:focus {
    outline: 3px solid var(--color-gold);
    outline-offset: 1px;
  }
  .search__results {
    position: absolute; top: 100%; left: 0; right: 0;
    list-style: none; margin: var(--space-2) 0 0; padding: 0;
    background: var(--bg-page);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    z-index: 10;
  }
  .search__results li { border-bottom: 1px solid var(--border-soft); }
  .search__results li:last-child { border-bottom: none; }
  .search__results a {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: var(--space-3) var(--space-4);
    text-decoration: none; color: var(--text-body);
  }
  .search__results a:hover { background: var(--bg-section); }

  .search__hint {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-sm);
    max-width: 560px;
  }
  .search__hint a {
    color: var(--color-navy);
    font-weight: var(--fw-medium);
  }

  .container > h2 { margin: var(--space-7) 0 var(--space-3); }
  .container > h2.states-h2 { margin-top: var(--space-8); }
  .section-lede { max-width: 70ch; margin: 0 0 var(--space-6); font-size: var(--fs-md); }

  .feature-list {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-5);
  }
  .feature {
    padding: var(--space-5) var(--space-5) var(--space-4);
    border: 1px solid var(--border-soft);
    border-left: 4px solid var(--color-gold);
    background: var(--bg-card);
  }
  .feature__eyebrow {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-navy);
    font-weight: var(--fw-medium);
    margin: 0 0 var(--space-2);
  }
  .feature h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-lg);
    line-height: 1.25;
  }
  .feature h3 a { color: var(--text-body); text-decoration: none; }
  .feature h3 a:hover { color: var(--color-navy); text-decoration: underline; }
  .feature p { margin: 0 0 var(--space-3); }
  .feature__hint { font-size: var(--fs-sm); margin-top: var(--space-2); }
  .feature__hint a { color: var(--color-navy); font-weight: var(--fw-medium); }

  /* State jump-list — compact, multi-column on wide screens. */
  .state-list {
    list-style: none; padding: 0; margin: 0 0 var(--space-7);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-2);
  }
  .state-list a {
    display: block;
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: var(--text-body);
    border-radius: var(--radius-sm);
  }
  .state-list a:hover { background: var(--bg-section); color: var(--color-navy); }

  /* Per-state city section. */
  .state-section {
    margin: var(--space-6) 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-soft);
  }
  .state-section h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-lg);
    color: var(--color-navy);
  }
  .city-list {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-2) var(--space-4);
  }
  .city-list a {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: var(--text-body);
    border-bottom: 1px solid var(--border-soft);
  }
  .city-list a:hover { background: var(--bg-section); color: var(--color-navy); }
  .city-list .muted { font-size: var(--fs-sm); }

  .coming-soon {
    margin: var(--space-7) 0 var(--space-7);
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--border-soft);
    font-size: var(--fs-sm);
    max-width: 80ch;
  }
  .coming-soon strong { color: var(--color-navy); }
</style>
