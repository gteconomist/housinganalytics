                const fmtPctChg = (v) => v == null
                  ? '—'
                  : (v >= 0 ? `${v.toFixed(0)}%` : `(${Math.abs(v).toFixed(0)}%)`);
                return (
                  <tr>
                    <td class="industry-table__name">
                      <span class="industry-table__title">{r.title}</span>
                      <span class="industry-table__naics muted">
                        SOC {r.soc}{r.soc_changed ? ' · prior-year code differs' : ''}
                      </span>
                    </td>
                    <td>{fmtInt(r.jobs)}</td>
                    <td class={chgCls}>{fmtChg(r.jobs_change)}</td>
                    <td class={pctCls}>{fmtPctChg(r.jobs_pct_change)}</td>
                    <td>{r.hourly != null ? `$${r.hourly.toFixed(2)}` : '—'}</td>
                    <td>{fmtMoney(r.annual)}</td>
                    <td>{fmtMoney(r.affordablePrice)}</td>
                    <td>{fmtMoney(r.affordableRent)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <figcaption class="muted">
          Affordable home price uses the same Section 3 formula (30% housing
          budget, 30-year mortgage at 7%, 5% down, $2,500/yr T&amp;I, 0.5% PMI).
          Affordable rent is 30% of monthly wages. Negative job-change values
          are shown in red parentheses. A "prior-year code differs" note flags
          occupations whose SOC code changed between the two vintages
          (2010 SOC → 2018 SOC) — the change estimate is best-effort.
        </figcaption>
        <small class="source">
          Source: {occupations.vintage_label ?? 'BLS OEWS'}. Jobs counts and
          wages reflect the MSA or nonmetropolitan area containing this
          county, not the county alone — OEWS is not published at the county
          level.
        </small>
      </figure>
    </section>
  )}

  <!-- ── Methodology footnote ─────────────────────────────────────── -->
  <section class="container report-section">
    <details class="methodology">
      <summary>Methodology &amp; sources</summary>
      <p>
        All figures derive from the {place.acs_year ?? '2024'} American Community Survey 5-year estimates
        pulled directly from the Census Data API at the place geography level. State and national
        comparisons are population-weighted aggregates of county-level estimates (an approximation;
        ACS publishes its own state and national medians which can differ slightly).
      </p>
      <p>
        HUD Area Median Income figures are inherited from the parent county (HUD publishes Income
        Limits at county/MSA level). BLS industry (QCEW) and occupation wage (OEWS) sections from
        the county profiles are not shown on place pages because those datasets are not published at
        sub-county geography — see the parent county profile for that context.
      </p>
      <p>
        The affordability calculator uses a 30% housing-budget rule with a 30-year mortgage. Defaults are
        7% interest, 5% down, $2,500/year taxes and insurance, and 0.5% PMI — adjustable above.
      </p>
      <p class="muted">
        Place GEOID: {place.geoid} · Parent county FIPS: {place.parent_county_fips ?? '—'}.
      </p>
    </details>
  </section>
</Base>

<!-- ── Data + Chart.js init ──────────────────────────────────────── -->
<script type="application/json" id="county-data" set:html={JSON.stringify({ county, chartData })}></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<!-- Export module: PNG buttons per chart + Excel/PDF buttons for [data-export-toolbar]. -->
<script src="/js/export.js" defer is:inline></script>
<script>
  const { county, chartData } = JSON.parse(document.getElementById('county-data').textContent);

  // Color palette pulled from CSS variables on the live element.
  const css = getComputedStyle(document.documentElement);
  const C = {
    navy:    '#003057',
    gold:    '#b3a369',
    amber:   css.getPropertyValue('--color-amber').trim(),
    cream:   '#f9f6e5',
    sage:    css.getPropertyValue('--color-sage').trim(),
    char:    '#545b5a',
    // Tertiary — used only when a chart has > 4 series.
    teal:    css.getPropertyValue('--color-teal').trim(),
    blue:    css.getPropertyValue('--color-blue').trim(),
    lteal:   css.getPropertyValue('--color-light-teal').trim(),
    purple:  css.getPropertyValue('--color-purple').trim(),
    lime:    css.getPropertyValue('--color-lime').trim(),
    red:     css.getPropertyValue('--color-red').trim(),
  };

  Chart.defaults.font.family = "'Geist', system-ui, sans-serif";
  // House style: all axis ticks, tick labels, and legend text in black.
  Chart.defaults.color = '#000';
  Chart.defaults.borderColor = '#e6e2d2';
  // Square corners on bar elements (house style).
  Chart.defaults.elements.bar = Chart.defaults.elements.bar || {};
  Chart.defaults.elements.bar.borderRadius = 0;

  // ── Custom plugin: data labels on top of bars ─────────────────
  // Self-contained replacement for chartjs-plugin-datalabels so we don't
  // depend on an external CDN that might fail to load.
  const dataLabels = {
    id: 'datalabels',
    afterDatasetsDraw(chart, _args, opts) {
      if (!opts || opts.display === false) return;
      const ctx = chart.ctx;
      chart.data.datasets.forEach((dataset, di) => {
        const meta = chart.getDatasetMeta(di);
        if (meta.hidden || !meta.data || meta.type !== 'bar') return;
        meta.data.forEach((bar, idx) => {
          const value = dataset.data[idx];
          if (value == null || !isFinite(value)) return;
          const formatted = opts.formatter ? opts.formatter(value) : String(value);
          if (!formatted) return;
          ctx.save();
          ctx.fillStyle = opts.color || C.navy;
          ctx.font = (opts.font || '500 11px Geist, system-ui, sans-serif');
          ctx.textAlign = 'center';
          ctx.textBaseline = 'bottom';
          ctx.fillText(formatted, bar.x, bar.y - 4);
          ctx.restore();
        });
      });
    },
  };
  Chart.register(dataLabels);

  const mk = (sel, cfg) => {
    const el = document.querySelector(`canvas[data-chart="${sel}"]`);
    if (!el) return;
    new Chart(el, cfg);
  };

  // ── Format helpers ─────────────────────────────────────────────
  const fmtPct   = v => (v == null || !isFinite(v)) ? '' : (v >= 10 ? v.toFixed(0) : v.toFixed(1)) + '%';
  const fmtInt   = v => (v == null || !isFinite(v)) ? '' : Math.round(v).toLocaleString();
  const fmtMoney = v => (v == null || !isFinite(v)) ? '' : '$' + Math.round(v).toLocaleString();

  // Top padding so data labels above the tallest bar aren't clipped.
  const CHART_TOP_PADDING = 22;

  // Common axis shape: no grid lines, axis line kept, black tick labels.
  const X_AXIS = (rotation) => ({
    grid:   { display: false },
    border: { display: true, color: '#000' },
    ticks:  { maxRotation: rotation, minRotation: rotation, autoSkip: false, color: '#000' },
  });
  const Y_AXIS = (extras = {}) => ({
    beginAtZero: true,
    grid:   { display: false },
    border: { display: true, color: '#000' },
    ticks:  { color: '#000', ...extras.ticks },
    ...extras,
  });

  // Option presets. `rotation` must be 0 or 45 per house style.
  function pctOpts({ legend = false, rotation = 0, max } = {}) {
    return {
      layout: { padding: { top: CHART_TOP_PADDING } },
      scales: {
        y: Y_AXIS({ max, ticks: { color: '#000', callback: v => v + '%' } }),
        x: X_AXIS(rotation),
      },
      plugins: {
        legend: legend ? { position: 'bottom', labels: { color: '#000' } } : { display: false },
        datalabels: { formatter: fmtPct },
      },
    };
  }
  function countOpts({ legend = false, rotation = 0 } = {}) {
    return {
      layout: { padding: { top: CHART_TOP_PADDING } },
      scales: {
        y: Y_AXIS(),
        x: X_AXIS(rotation),
      },
      plugins: {
        legend: legend ? { position: 'bottom', labels: { color: '#000' } } : { display: false },
        datalabels: { formatter: fmtInt },
      },
    };
  }
  function moneyOpts({ legend = false, rotation = 0 } = {}) {
    return {
      layout: { padding: { top: CHART_TOP_PADDING } },
      scales: {
        y: Y_AXIS({ ticks: { color: '#000', callback: v => '$' + v.toLocaleString() } }),
        x: X_AXIS(rotation),
      },
      plugins: {
        legend: legend ? { position: 'bottom', labels: { color: '#000' } } : { display: false },
        datalabels: { formatter: fmtMoney },
      },
    };
  }

  // ── Charts ─────────────────────────────────────────────────────
  mk('race', {
    type: 'bar',
    data: {
      labels: chartData.race.labels,
      datasets: [{ data: chartData.race.county, backgroundColor: C.navy }],
    },
    options: pctOpts({ rotation: 45, max: 100 }),
  });

  mk('education', {
    type: 'bar',
    data: {
      labels: chartData.education.labels,
      datasets: [{ data: chartData.education.values, backgroundColor: C.gold }],
    },
    options: countOpts({ rotation: 45 }),
  });

  mk('tenure', {
    type: 'doughnut',
    data: {
      labels: chartData.tenure.labels,
      datasets: [{ data: chartData.tenure.values, backgroundColor: [C.navy, C.gold] }],
    },
    options: {
      plugins: {
        legend: { position: 'bottom' },
        datalabels: { display: false }, // bar-only plugin; skip on donut
        tooltip: {
          callbacks: { label: ctx => `${ctx.label}: ${ctx.parsed.toFixed(1)}%` },
        },
      },
    },
  });

  mk('structure', {
    type: 'bar',
    data: {
      labels: chartData.structure.labels,
      datasets: [{ data: chartData.structure.values, backgroundColor: C.navy }],
    },
    options: pctOpts({ rotation: 45 }),
  });

  mk('yearBuilt', {
    type: 'bar',
    data: {
      labels: chartData.yearBuilt.labels,
      datasets: [{ data: chartData.yearBuilt.values, backgroundColor: C.navy }],
    },
    options: countOpts({ rotation: 45 }),
  });

  // Housing size mismatch: bedrooms vs household size on a unified percent axis.
  // Bedrooms: 0/1/2/3/4/5+ → align to household size buckets 1/2/3/4+ as the report does.
  // We render them as paired groups: BR distribution vs HH-size distribution.
  const brTotal = chartData.bedrooms.units.reduce((a,b) => a + (b||0), 0) || 1;
  const hhTotal = chartData.hhSize.values.reduce((a,b) => a + (b||0), 0) || 1;
  const brPct = chartData.bedrooms.units.map(v => (v||0)/brTotal*100);
  const hhPct = chartData.hhSize.values.map(v => (v||0)/hhTotal*100);
  mk('sizeMismatch', {
    type: 'bar',
    data: {
      labels: ['Studio / 1 person', '1 BR / 2 person', '2 BR / 3 person', '3+ BR / 4+ person'],
      datasets: [
        { label: 'Housing units (% by BR)', data: [brPct[0]+brPct[1], brPct[2], brPct[3], brPct[4]+brPct[5]], backgroundColor: C.navy },
        { label: 'Households (% by size)',  data: hhPct, backgroundColor: C.gold },
      ],
    },
    options: pctOpts({ legend: true, rotation: 0 }),
  });

  mk('homeValue', {
    type: 'bar',
    data: {
      labels: chartData.homeValue.labels,
      datasets: [{ data: chartData.homeValue.values, backgroundColor: C.navy }],
    },
    options: countOpts({ rotation: 45 }),
  });

  mk('rentByBR', {
    type: 'bar',
    data: {
      labels: chartData.rentByBR.labels,
      datasets: [{ data: chartData.rentByBR.county, backgroundColor: C.navy }],
    },
    options: moneyOpts({ rotation: 0 }),
  });

  mk('renterAge', {
    type: 'bar',
    data: {
      labels: chartData.tenureAge.labels,
      datasets: [{ data: chartData.tenureAge.renters, backgroundColor: C.gold }],
    },
    options: countOpts({ rotation: 0 }),
  });
  mk('ownerAge', {
    type: 'bar',
    data: {
      labels: chartData.tenureAge.labels,
      datasets: [{ data: chartData.tenureAge.owners, backgroundColor: C.navy }],
    },
    options: countOpts({ rotation: 0 }),
  });

  // Renter cost burden: deliberate 3-stop visual signal —
  //   <30% income to housing  = sage  (#d6dbd4)  — healthy
  //   30%–49.9%               = navy  (#003057)  — cost burdened
  //   50%+                    = red   (#e04f39)  — severely cost burdened
  mk('renterBurden', {
    type: 'bar',
    data: {
      labels: chartData.renterBurden.labels,
      datasets: [{
        data: chartData.renterBurden.values,
        backgroundColor: chartData.renterBurden.labels.map((_, i) =>
          i < 5 ? C.sage : (i < 8 ? C.navy : C.red)
        ),
      }],
    },
    options: countOpts({ rotation: 0 }),
  });
  mk('ownerBurden', {
    type: 'bar',
    data: {
      labels: chartData.ownerBurden.labels,
      datasets: [{ data: chartData.ownerBurden.values, backgroundColor: C.navy }],
    },
    options: countOpts({ rotation: 0 }),
  });

  mk('incomeByTenure', {
    type: 'bar',
    data: {
      labels: chartData.incomeByTenure.labels,
      datasets: [
        { label: 'Owners',  data: chartData.incomeByTenure.owners,  backgroundColor: C.navy },
        { label: 'Renters', data: chartData.incomeByTenure.renters, backgroundColor: C.gold },
      ],
    },
    options: countOpts({ legend: true, rotation: 45 }),
  });

  // ── New charts ───────────────────────────────────────────────
  // Median HH income by tenure (county vs state grouped bars)
  mk('incomeByTenureMedians', {
    type: 'bar',
    data: {
      labels: chartData.incomeByTenureMedians.labels,
      datasets: [
        { label: 'County', data: chartData.incomeByTenureMedians.county, backgroundColor: C.navy },
        { label: 'State',  data: chartData.incomeByTenureMedians.state,  backgroundColor: C.gold },
      ],
    },
    options: moneyOpts({ legend: true, rotation: 0 }),
  });

  // Median HH income by age of householder
  mk('incomeByAge', {
    type: 'bar',
    data: {
      labels: chartData.incomeByAge.labels,
      datasets: [{ data: chartData.incomeByAge.values, backgroundColor: C.navy }],
    },
    options: moneyOpts({ rotation: 0 }),
  });

  // Median income by number of earners
  mk('earnersIncome', {
    type: 'bar',
    data: {
      labels: chartData.earnersIncome.labels,
      datasets: [{ data: chartData.earnersIncome.values, backgroundColor: C.navy }],
    },
    options: moneyOpts({ rotation: 0 }),
  });

  // Household size distribution
  mk('householdSize', {
    type: 'bar',
    data: {
      labels: chartData.householdSize.labels,
      datasets: [{ data: chartData.householdSize.values, backgroundColor: C.gold }],
    },
    options: countOpts({ rotation: 0 }),
  });

  // Number of bedrooms
  mk('bedroomsDistribution', {
    type: 'bar',
    data: {
      labels: chartData.bedroomsDistribution.labels,
      datasets: [{ data: chartData.bedroomsDistribution.values, backgroundColor: C.navy }],
    },
    options: countOpts({ rotation: 0 }),
  });

  // Monthly housing costs distribution
  mk('monthlyHousingCost', {
    type: 'bar',
    data: {
      labels: chartData.monthlyHousingCost.labels,
      datasets: [{ data: chartData.monthlyHousingCost.values, backgroundColor: C.navy }],
    },
    options: countOpts({ rotation: 45 }),
  });

  // ── Section 2: vacancy analytics ──────────────────────────────
  if (chartData.vacancyComposition && chartData.vacancyComposition.labels.length) {
    const vacancyColors = [
      C.navy, C.blue, C.gold, C.amber, C.sage, C.teal, C.char,
    ];
    mk('vacancyComposition', {
      type: 'doughnut',
      data: {
        labels: chartData.vacancyComposition.labels,
        datasets: [{
          data: chartData.vacancyComposition.values,
          backgroundColor: vacancyColors.slice(0, chartData.vacancyComposition.labels.length),
        }],
      },
      options: {
        plugins: {
          legend: { position: 'bottom' },
          datalabels: { display: false },
          tooltip: {
            callbacks: {
              label: ctx => {
                const total = ctx.dataset.data.reduce((a, b) => a + b, 0) || 1;
                const pct = ((ctx.parsed / total) * 100).toFixed(1);
                return `${ctx.label}: ${ctx.parsed.toLocaleString()} units (${pct}%)`;
              },
            },
          },
        },
      },
    });
  }

  if (chartData.vacancyFrictionalStructural) {
    mk('vacancyFrictionalStructural', {
      type: 'bar',
      data: {
        labels: chartData.vacancyFrictionalStructural.labels,
        datasets: [{
          data: chartData.vacancyFrictionalStructural.values,
          backgroundColor: [C.navy, C.gold],
        }],
      },
      options: countOpts({ rotation: 0 }),
    });
  }

  // ── Section 4: top sectors by employment ──────────────────────
  if (chartData.industryTopSectors && chartData.industryTopSectors.labels.length) {
    mk('industryTopSectors', {
      type: 'bar',
      data: {
        labels: chartData.industryTopSectors.labels,
        datasets: [{ data: chartData.industryTopSectors.emp, backgroundColor: C.navy }],
      },
      options: countOpts({ rotation: 45 }),
    });
  }

  // ── Section 4: sectors / subsectors table toggle ──────────────
  document.querySelectorAll('[data-industry-view]').forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.getAttribute('data-industry-view');
      // Swap which button is active.
      document.querySelectorAll('[data-industry-view]').forEach(b =>
        b.classList.toggle('industry-toggle__btn--active', b === btn));
      // Swap visible table.
      document.querySelectorAll('[data-industry-table]').forEach(t => {
        t.hidden = t.getAttribute('data-industry-table') !== view;
      });
    });
  });

  // ── Affordability calculator ──────────────────────────────────
  const aff = {
    basis:   document.getElementById('aff-basis'),
    income:  document.getElementById('aff-income'),
    rate:    document.getElementById('aff-rate'),
    down:    document.getElementById('aff-down'),
    ti:      document.getElementById('aff-ti'),
    monthly: document.getElementById('aff-monthly'),
    price:   document.getElementById('aff-price'),
    priceMhi: document.getElementById('aff-price-mhi'),
  };
  // Income basis lookup table — populates the income input when the user
  // changes the dropdown. "custom" leaves whatever they typed alone.
  const basisValues = {
    mhi: county.hh_income_median ?? null,
    ami_80_1p:  county.hud_ami?.ami_80_1p  ?? null,
    ami_100_1p: county.hud_ami?.ami_100_1p ?? null,
    ami_120_1p: county.hud_ami?.ami_120_1p ?? null,
    ami_80_2p:  county.hud_ami?.ami_80_2p  ?? null,
    ami_100_2p: county.hud_ami?.ami_100_2p ?? null,
    ami_120_2p: county.hud_ami?.ami_120_2p ?? null,
    ami_80_4p:  county.hud_ami?.ami_80_4p  ?? null,
    ami_100_4p: county.hud_ami?.ami_100_4p ?? null,
    ami_120_4p: county.hud_ami?.ami_120_4p ?? null,
  };
  if (aff.basis) {
    aff.basis.addEventListener('change', () => {
      const v = basisValues[aff.basis.value];
      if (v != null) { aff.income.value = Math.round(v); update(); }
    });
    // Typing in the income field switches the dropdown to "custom" so it's clear
    // what's driving the number.
    aff.income.addEventListener('input', () => { aff.basis.value = 'custom'; });
  }
  function recalc(income, rate, downPct, ti) {
    const monthlyBudget = (income * 0.30) / 12;
    const monthlyTaxIns = ti / 12;
    const monthlyRate = (rate / 100) / 12;
    const n = 360;
    const pmiMonthlyRate = 0.005 / 12;
    const piFactor = monthlyRate === 0
      ? (1 / n)
      : (monthlyRate * Math.pow(1 + monthlyRate, n)) / (Math.pow(1 + monthlyRate, n) - 1);
    const principal = (monthlyBudget - monthlyTaxIns) / (piFactor + pmiMonthlyRate);
    const price = principal > 0 ? principal / (1 - downPct / 100) : 0;
    return { monthlyBudget, price: Math.max(0, price) };
  }
  function update() {
    const inc  = parseFloat(aff.income.value)  || 0;
    const rate = parseFloat(aff.rate.value)    || 0;
    const dp   = parseFloat(aff.down.value)    || 0;
    const ti   = parseFloat(aff.ti.value)      || 0;
    const { monthlyBudget, price } = recalc(inc, rate, dp, ti);
    aff.monthly.textContent = '$' + Math.round(monthlyBudget).toLocaleString();
    aff.price.textContent   = '$' + Math.round(price).toLocaleString();
  }
  ['income', 'rate', 'down', 'ti'].forEach(k => aff[k]?.addEventListener('input', update));
  update();
  // Anchor: home price at MHI
  if (aff.priceMhi && county.hh_income_median) {
    const { price } = recalc(county.hh_income_median, 7, 5, 2500);
    aff.priceMhi.textContent = '$' + Math.round(price).toLocaleString();
  }
</script>

<style>
  .county-hero {
    background: var(--bg-section);
    padding: var(--space-7) 0 var(--space-6);
    border-bottom: 1px solid var(--border-soft);
  }
  .county-hero h1 { font-size: var(--fs-3xl); margin-bottom: var(--space-2); }
  .county-hero__lede { font-size: var(--fs-md); margin-bottom: var(--space-6); }

  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--space-3);
  }
  .kpi {
    background: var(--bg-card);
    border-left: 3px solid var(--color-gold);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-soft);
  }
  .kpi__label { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: var(--space-1); }
  .kpi__value { font-size: var(--fs-xl); font-weight: var(--fw-semibold); color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .kpi__delta { font-size: var(--fs-xs); margin-top: 2px; }

  .report-section { padding-top: var(--space-7); }
  .section-head { margin-bottom: var(--space-5); }
  .section-head h2 { margin-bottom: var(--space-2); }

  .grid { display: grid; gap: var(--space-4); margin-bottom: var(--space-4); }
  .grid-2 { grid-template-columns: 1fr 1fr; }
  .grid-3 { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 800px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }

  /* Vacancy stat callouts — used for seasonal share + distress share in
     Section 2. .stat-card--flag highlights when a threshold is crossed. */
  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-left: 4px solid var(--color-navy);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }
  .stat-card--flag {
    border-left-color: var(--color-orange-red, #e04f39);
    background: #fdf3f0;
  }
  .stat-card__label { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin: 0 0 var(--space-2); }
  .stat-card__value { font-size: var(--fs-xl); font-weight: var(--fw-bold); color: var(--color-navy); margin: 0 0 var(--space-1); }
  .stat-card--flag .stat-card__value { color: var(--color-orange-red, #e04f39); }
  .stat-card__sub   { font-size: var(--fs-sm); color: var(--text-muted); margin: 0 0 var(--space-2); font-variant-numeric: tabular-nums; }
  .stat-card__hint  { font-size: var(--fs-sm); color: var(--text-body); margin: 0; }

  .card {
