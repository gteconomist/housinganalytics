---
import Base from '../../../layouts/Base.astro';
import manifest from '../../../data/generated/manifest.json';
import { fmtMoney, fmtInt, fmtPct, fmtRatio, affordableHomePrice } from '../../../lib/format.js';

// Generate one static page per place at build time.
//
// IMPORTANT: This template is a near-clone of the county profile. Place data
// has the same shape as county data (same field names, same derived metrics)
// because build-data.mjs normalizes both through the same code path. To keep
// the template diff trivial we alias `place` as `county` below — every chart,
// table, and KPI tile then renders unchanged.
//
// Differences vs. the county template:
//   • Hero shows place_name and state_name
//   • HUD AMI is inherited from the parent county (build-data sets this)
//   • Sections 4 (QCEW industries) and 5 (OEWS wages) auto-hide because the
//     build sets place.industries = null and place.occupations = null
export async function getStaticPaths() {
  const m = (await import('../../../data/generated/manifest.json')).default;
  return (m.places ?? []).map(p => ({
    params: { state: p.state_slug, slug: p.slug },
    props:  { geoid: p.geoid },
  }));
}

const { geoid } = Astro.props;
const place = (await import(`../../../data/generated/places/${geoid}.json`)).default;
// Alias so the (county-shaped) template code below keeps working unchanged.
const county = place;
const state    = county._context.state;
const national = county._context.national;

// ──────────────────────────────────────────────────────────────────
// Pre-shape data for charts (so the client-side script just receives plain
// JSON in <script type="application/json"> tags and stays small).
// ──────────────────────────────────────────────────────────────────
function pct(part, whole) { return (whole && part != null) ? (part / whole) * 100 : 0; }

const tot_units    = county.units_total ?? 0;
const tot_occupied = county.tenure_total_occupied ?? 0;
const tot_renter   = county.tenure_renter_occupied ?? 0;
const tot_owner    = county.tenure_owner_occupied ?? 0;
const tot_pop      = county.population_total ?? 0;

const chartData = {
  // 1. Racial composition (county vs state)
  race: {
    labels: ['White', 'Black', 'Asian', 'Two or more', 'Other / NHPI / AIAN'],
    county: [
      pct(county.race_white,    tot_pop),
      pct(county.race_black,    tot_pop),
      pct(county.race_asian,    tot_pop),
      pct(county.race_two_plus, tot_pop),
      pct((county.race_other ?? 0) + (county.race_aian ?? 0) + (county.race_nhpi ?? 0), tot_pop),
    ],
    // For state context, build the same shares from the state agg fields:
    state: [],
  },

  // 2. Tenure
  tenure: {
    labels: ['Owner-occupied', 'Renter-occupied'],
    values: [
      pct(county.tenure_owner_occupied,  tot_occupied),
      pct(county.tenure_renter_occupied, tot_occupied),
    ],
    state: [
      state.homeownership_rate ?? 0,
      state.renter_rate ?? 0,
    ],
  },

  // 3. Structure type
  structure: {
    labels: ['SFD', 'SFA', '2 units', '3–4', '5–9', '10–19', '20–49', '50+', 'Mobile', 'Other'],
    values: [
      pct(county.structure_1_detached, tot_units),
      pct(county.structure_1_attached, tot_units),
      pct(county.structure_2,          tot_units),
      pct(county.structure_3_4,        tot_units),
      pct(county.structure_5_9,        tot_units),
      pct(county.structure_10_19,      tot_units),
      pct(county.structure_20_49,      tot_units),
      pct(county.structure_50_plus,    tot_units),
      pct(county.structure_mobile,     tot_units),
      pct(county.structure_other,      tot_units),
    ],
  },

  // 4. Year built
  yearBuilt: {
    labels: ['Pre-1940', '1940–59', '1960–79', '1980–99', '2000–09', '2010–19', '2020+'],
    values: [
      county.year_built_1939_earlier,
      county.year_built_1940_59,
      county.year_built_1960_79,
      county.year_built_1980_99,
      county.year_built_2000_09,
      county.year_built_2010_19,
      county.year_built_2020_plus,
    ],
  },

  // 5. Bedrooms vs household size (the "housing size mismatch")
  bedrooms: {
    labels: ['Studio', '1 BR', '2 BR', '3 BR', '4 BR', '5+ BR'],
    units:  [county.br_0, county.br_1, county.br_2, county.br_3, county.br_4, county.br_5_plus],
  },
  hhSize: {
    labels: ['1 person', '2 person', '3 person', '4+ person'],
    values: [county.hh_size_1, county.hh_size_2, county.hh_size_3, county.hh_size_4_plus],
  },

  // 6. Home value distribution
  homeValue: {
    labels: ['<$50K', '$50–99K', '$100–150K', '$150–200K', '$200–300K', '$300–500K', '$500K–1M', '$1M+'],
    values: [
      county.value_lt_50k, county.value_50_99k, county.value_100_150k, county.value_150_200k,
      county.value_200_300k, county.value_300_500k, county.value_500_1m, county.value_1m_plus,
    ],
  },

  // 7. Median rent by bedroom
  rentByBR: {
    labels: ['Studio', '1 BR', '2 BR', '3 BR', '4 BR', '5+ BR'],
    county: [county.rent_median_0br, county.rent_median_1br, county.rent_median_2br,
             county.rent_median_3br, county.rent_median_4br, county.rent_median_5br],
  },

  // 8. Renter cost burden
  renterBurden: {
    labels: ['<10%', '10–14%', '15–19%', '20–24%', '25–29%', '30–34%', '35–39%', '40–49%', '50%+'],
    values: [
      county.rent_burden_lt_10, county.rent_burden_10_14, county.rent_burden_15_19,
      county.rent_burden_20_24, county.rent_burden_25_29, county.rent_burden_30_34,
      county.rent_burden_35_39, county.rent_burden_40_49, county.rent_burden_50_plus,
    ],
  },

  // 9. Owner cost burden (B25106: by income band, 30%+ buckets) — quick view
  ownerBurden: {
    labels: ['<$20K', '$20–35K', '$35–50K', '$50–75K', '$75K+'],
    values: [
      county.cb_owner_30_plus_lt20k,   county.cb_owner_30_plus_20_35k,
      county.cb_owner_30_plus_35_50k, county.cb_owner_30_plus_50_75k,
      county.cb_owner_30_plus_75k_plus,
    ],
  },

  // 10. Tenure × age
  tenureAge: {
    labels: ['<35', '35–44', '45–54', '55–64', '65–74', '75–84', '85+'],
    owners: [
      county.owner_age_under35, county.owner_age_35_44, county.owner_age_45_54,
      county.owner_age_55_64, county.owner_age_65_74, county.owner_age_75_84, county.owner_age_85_plus,
    ],
    renters: [
      county.renter_age_under35, county.renter_age_35_44, county.renter_age_45_54,
      county.renter_age_55_64, county.renter_age_65_74, county.renter_age_75_84, county.renter_age_85_plus,
    ],
  },

  // 11. Owner vs Renter income distributions
  incomeByTenure: {
    labels: ['<$5K', '$5–10K', '$10–15K', '$15–20K', '$20–25K', '$25–35K', '$35–50K',
             '$50–75K', '$75–100K', '$100–150K', '$150K+'],
    owners: [
      county.oi_lt_5k, county.oi_5_10k, county.oi_10_15k, county.oi_15_20k, county.oi_20_25k,
      county.oi_25_35k, county.oi_35_50k, county.oi_50_75k, county.oi_75_100k, county.oi_100_150k,
      county.oi_150k_plus,
    ],
    renters: [
      county.ri_lt_5k, county.ri_5_10k, county.ri_10_15k, county.ri_15_20k, county.ri_20_25k,
      county.ri_25_35k, county.ri_35_50k, county.ri_50_75k, county.ri_75_100k, county.ri_100_150k,
      county.ri_150k_plus,
    ],
  },

  // 12. Education attainment
  education: {
    labels: ['<9th', '9–12 no dipl.', 'HS grad', 'Some college', "Assoc.", "Bachelor's", 'Graduate'],
    values: [
      county.edu_lt_9th, county.edu_9_12_no_diploma, county.edu_hs_grad,
      county.edu_some_college, county.edu_associates, county.edu_bachelors, county.edu_graduate,
    ],
  },

  // 13. Median HH income by tenure — county vs state
  incomeByTenureMedians: {
    labels: ['All households', 'Owner-occupied', 'Renter-occupied'],
    county: [county.hh_income_median, county.income_median_owner, county.income_median_renter],
    state:  [state.hh_income_median,  state.income_median_owner ?? null, state.income_median_renter ?? null],
  },

  // 14. Median HH income by age of householder
  incomeByAge: {
    labels: ['Under 25', '25–44', '45–64', '65+'],
    values: [
      county.income_median_under25, county.income_median_25_44,
      county.income_median_45_64,   county.income_median_65_plus,
    ],
  },

  // 15. Median income by number of earners (Figure 22)
  earnersIncome: {
    labels: ['0 earners', '1 earner', '2 earners', '3+ earners'],
    values: [
      county.earners_0_income, county.earners_1_income,
      county.earners_2_income, county.earners_3_plus_income,
    ],
  },

  // 16. Earners table (Table 7 — count, share, income, attainable home)
  earnersTable: {
    rows: [
      ['0 earners',   county.earners_0,      county.earners_0_income],
      ['1 earner',    county.earners_1,      county.earners_1_income],
      ['2 earners',   county.earners_2,      county.earners_2_income],
      ['3+ earners',  county.earners_3_plus, county.earners_3_plus_income],
    ],
    total_families: (county.earners_0 ?? 0) + (county.earners_1 ?? 0) +
                    (county.earners_2 ?? 0) + (county.earners_3_plus ?? 0),
  },

  // 17. Household size (Figure 32)
  householdSize: {
    labels: ['1 person', '2 person', '3 person', '4+ person'],
    values: [county.hh_size_1, county.hh_size_2, county.hh_size_3, county.hh_size_4_plus],
  },

  // 18. Number of bedrooms (Figure 33)
  bedroomsDistribution: {
    labels: ['Studio', '1 BR', '2 BR', '3 BR', '4 BR', '5+ BR'],
    values: [county.br_0, county.br_1, county.br_2, county.br_3, county.br_4, county.br_5_plus],
  },

  // 19. Monthly housing costs (Figure 34)
  monthlyHousingCost: {
    labels: ['<$500', '$500–999', '$1,000–1,499', '$1,500–1,999', '$2,000–2,499', '$2,500–2,999', '$3,000+'],
    values: [
      county.mhc_lt_500, county.mhc_500_999, county.mhc_1000_1499,
      county.mhc_1500_1999, county.mhc_2000_2499, county.mhc_2500_2999,
      county.mhc_3000_plus,
    ],
  },
};

// Section 4 chart data is filled below after topSectors is computed.
chartData.industryTopSectors = { labels: [], emp: [], wage: [] };

// Vacancy composition (Section 2). Render only the categories that actually
// have units in this place — keeps the donut from showing zero-width slivers.
chartData.vacancyComposition = (() => {
  const buckets = [
    ['For rent',                'vacant_for_rent'],
    ['Rented, not occupied',    'vacant_rented_not_occ'],
    ['For sale',                'vacant_for_sale'],
    ['Sold, not occupied',      'vacant_sold_not_occ'],
    ['Seasonal / recreational', 'vacant_seasonal'],
    ['Migrant workers',         'vacant_migrant'],
    ['Other',                   'vacant_other'],
  ];
  const labels = [], values = [];
  for (const [label, field] of buckets) {
    const v = county[field] ?? 0;
    if (v > 0) { labels.push(label); values.push(v); }
  }
  return { labels, values };
})();

chartData.vacancyFrictionalStructural = {
  labels: ['Frictional', 'Structural'],
  values: [county.vacant_frictional ?? 0, county.vacant_structural ?? 0],
};

// Workforce housing range
const mhi = county.hh_income_median;
const workforceLow  = mhi ? mhi * 0.80 : null;
const workforceHigh = mhi ? mhi * 1.20 : null;

// HUD AMI (may be null if the HUD fetch step didn't run / failed). The page
// guards every reference so the section just collapses gracefully.
const hud = county.hud_ami;

// ── Section 4: Industry & Workforce Wages (BLS QCEW) ──────────────
// county.industries is null when QCEW didn't load (graceful degrade).
const industries = county.industries;

// Attach affordability (home price + max rent at 30% of gross) to every
// industry row. Reuses the same calc as the Section 3 affordability widget
// so numbers tie out: 7% rate, 5% down, 30-yr, $2,500/yr T&I, 0.5% PMI,
// 30% housing-budget rule.
function withAffordability(row) {
  const inc = row.avg_annual_pay;
  if (inc == null) return { ...row, affordablePrice: null, affordableRent: null, affordablePriceVsMedian: null };
  const r = affordableHomePrice({ annualIncome: inc });
  const price = r?.homePrice ?? null;
  return {
    ...row,
    affordablePrice: price,
    affordableRent:  (inc * 0.30) / 12,
    affordablePriceVsMedian:
      (price != null && county.value_median != null) ? price - county.value_median : null,
  };
}

const sectorRows    = (industries?.sectors    ?? []).map(withAffordability);
const subsectorRows = (industries?.subsectors ?? []).map(withAffordability);

// Top 10 sectors by employment for the chart.
const topSectors = sectorRows.slice(0, 10);
const totalIndustryEmp = sectorRows.reduce((s, r) => s + (r.emp ?? 0), 0);
const totalIndustryEstabs = sectorRows.reduce((s, r) => s + (r.estabs ?? 0), 0);

// Industry-weighted average annual pay across all sectors (single headline number).
let _payNum = 0, _payDen = 0;
for (const r of sectorRows) {
  if (r.avg_annual_pay != null && r.emp != null && r.emp > 0) {
    _payNum += r.avg_annual_pay * r.emp;
    _payDen += r.emp;
  }
}
const overallAvgAnnualPay = _payDen > 0 ? _payNum / _payDen : null;

// Fill the Section 4 chart payload now that topSectors is known.
chartData.industryTopSectors = {
  labels: topSectors.map(r => r.title),
  emp:    topSectors.map(r => r.emp ?? 0),
  wage:   topSectors.map(r => r.avg_annual_pay ?? 0),
};

// ── Section 5: Wages by Occupation (BLS OEWS) ─────────────────────
// county.occupations is null when OEWS didn't load (graceful degrade).
const occupations = county.occupations;

// Attach affordability per occupation row. Uses the same Section 3 formula
// so the columns tie out across the page.
function withOccAffordability(row) {
  const inc = row.annual;
  if (inc == null) return { ...row, affordablePrice: null, affordableRent: null };
  const r = affordableHomePrice({ annualIncome: inc });
  return {
    ...row,
    affordablePrice: r?.homePrice ?? null,
    affordableRent:  (inc * 0.30) / 12,
  };
}
// Sort by annual wage ascending (matches Alfie's reference report style:
// low-wage essential workers up top, high-wage at the bottom).
const occRows = (occupations?.rows ?? [])
  .filter(r => r.annual != null)
  .map(withOccAffordability)
  .sort((a, b) => (a.annual ?? 0) - (b.annual ?? 0));
---

<Base title={`${place.place_name}, ${place.state_name}`} county={county}>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="county-hero">
    <div class="container">
      <p class="eyebrow">{place.state_name} · Place GEOID {place.geoid}</p>
      <h1>{place.place_name}</h1>
      <p class="county-hero__lede muted">
        ACS 5-year {place.acs_year ?? ''} estimates · population {fmtInt(place.population_total)} ·
        {fmtInt(place.units_total)} housing units
      </p>

      <!-- Export toolbar — wired by /js/export.js -->
      <div class="export-toolbar" data-export-toolbar aria-label="Download this profile">
        <span class="export-toolbar__label">Download:</span>
        <button type="button" data-export="xlsx" title="Download all data as Excel workbook">
          Excel (.xlsx)
        </button>
        <button type="button" data-export="pdf" title="Download this profile as PDF">
          PDF
        </button>
        <span class="muted" style="font-size: var(--fs-xs);">
          Charts also have a PNG button (hover any chart).
        </span>
      </div>

      <div class="kpis">
        <div class="kpi"><div class="kpi__label">Median household income</div>
          <div class="kpi__value">{fmtMoney(county.hh_income_median)}</div>
          <div class="kpi__delta muted">State {fmtMoney(state.hh_income_median)}</div></div>
        <div class="kpi"><div class="kpi__label">Median home value</div>
          <div class="kpi__value">{fmtMoney(county.value_median)}</div>
          <div class="kpi__delta muted">State {fmtMoney(state.value_median)}</div></div>
        <div class="kpi"><div class="kpi__label">Median gross rent</div>
          <div class="kpi__value">{fmtMoney(county.rent_median)}</div>
          <div class="kpi__delta muted">State {fmtMoney(state.rent_median)}</div></div>
        <div class="kpi"><div class="kpi__label">Homeownership rate</div>
          <div class="kpi__value">{fmtPct(county.homeownership_rate)}</div>
          <div class="kpi__delta muted">State {fmtPct(state.homeownership_rate)}</div></div>
        <div class="kpi"><div class="kpi__label">Renter cost-burden rate</div>
          <div class="kpi__value">{fmtPct(county.renter_cost_burden_rate)}</div>
          <div class="kpi__delta muted">≥30% of income</div></div>
        <div class="kpi"><div class="kpi__label">Owner cost-burden rate</div>
          <div class="kpi__value">{fmtPct(county.owner_cost_burden_rate)}</div>
          <div class="kpi__delta muted">≥30% of income</div></div>
        <div class="kpi"><div class="kpi__label">Homeowner vacancy</div>
          <div class="kpi__value">{fmtPct(county.homeowner_vacancy_rate)}</div>
          <div class="kpi__delta muted">Of owner-occupied + for-sale units</div></div>
        <div class="kpi"><div class="kpi__label">Rental vacancy</div>
          <div class="kpi__value">{fmtPct(county.rental_vacancy_rate)}</div>
          <div class="kpi__delta muted">Of renter-occupied + for-rent units</div></div>
        <div class="kpi"><div class="kpi__label">Overall vacancy</div>
          <div class="kpi__value">{fmtPct(county.vacancy_rate)}</div>
          <div class="kpi__delta muted">All housing units</div></div>
        <div class="kpi"><div class="kpi__label">Price-to-income ratio</div>
          <div class="kpi__value">{fmtRatio(county.price_to_income_ratio)}</div>
          <div class="kpi__delta muted">Affordable: 2.0–3.0</div></div>
      </div>
    </div>
  </section>

  <!-- ── 1. Community Profile ─────────────────────────────────────── -->
  <section class="container report-section">
    <header class="section-head">
      <p class="eyebrow">Section 1</p>
      <h2>Community Profile</h2>
      <p class="muted">Population, demographics, household composition, and income.</p>
    </header>

    <!-- Community Data Summary — at-a-glance reference table -->
    <div class="card">
      <h3>Community Data Summary</h3>
      <table class="summary-table">
        <thead>
          <tr><th></th><th>{place.place_name}</th><th>{place.state_name}</th></tr>
        </thead>
        <tbody>
          <tr><th>Population</th>
            <td>{fmtInt(county.population_total)}</td>
            <td>{fmtInt(state.population_total)}</td></tr>
          {county.population_density != null && (
            <tr><th>Population density (per sq. mi.)</th>
              <td>{fmtRatio(county.population_density)}</td>
              <td>—</td></tr>
          )}
          <tr><th>Median household income</th>
            <td>{fmtMoney(county.hh_income_median)}</td>
            <td>{fmtMoney(state.hh_income_median)}</td></tr>
          <tr><th>HUD Area Median Income (4-person, 100%)</th>
            <td>{hud ? fmtMoney(hud.ami_100_4p) : '—'}</td>
            <td>—</td></tr>
          <tr><th>Households</th>
            <td>{fmtInt(county.hh_total_s1101)}</td>
            <td>—</td></tr>
          <tr><th>Average household size</th>
            <td>{fmtRatio(county.hh_avg_size)} people</td>
            <td>—</td></tr>
          <tr><th>Owner-occupied</th>
            <td>{fmtPct(county.homeownership_rate)}</td>
            <td>{fmtPct(state.homeownership_rate)}</td></tr>
          <tr><th>Renter-occupied</th>
            <td>{fmtPct(county.renter_rate)}</td>
            <td>{fmtPct(state.renter_rate)}</td></tr>
          <tr><th>Race</th>
            <td>{fmtPct(pct(county.race_white, county.population_total))} White ·
                {fmtPct(pct(county.race_black, county.population_total))} Black</td>
            <td>{fmtPct(pct(state.race_white,  state.population_total))} White ·
                {fmtPct(pct(state.race_black,  state.population_total))} Black</td></tr>
        </tbody>
      </table>
      <small class="source">Source: ACS 5-year 2024 (Tables DP05, S1101, DP04, S1901){county.population_density != null ? ' and Census Gazetteer (land area)' : ''}; HUD FY2026 Income Limits.</small>
    </div>

    <div class="grid grid-2">
      <figure class="card">
        <h3>Racial composition</h3>
        <canvas data-chart="race"></canvas>
        <figcaption class="muted">
          {place.place_name} compared with {place.state_name}.
        </figcaption>
        <small class="source">Source: ACS 5-year 2024, Table DP05.</small>
      </figure>

      <figure class="card">
        <h3>Educational attainment (population 25+)</h3>
        <canvas data-chart="education"></canvas>
        <figcaption class="muted">
          {fmtPct(county.bachelors_plus_rate)} hold a bachelor's degree or higher
          (state: {fmtPct(state.bachelors_plus_rate)}).
        </figcaption>
        <small class="source">Source: ACS 5-year 2024, Table S1501.</small>
      </figure>
    </div>

    <!-- Median HH income by tenure + by age of householder -->
    <div class="grid grid-2">
      <figure class="card">
        <h3>Median Household Income by Tenure</h3>
        {county.income_median_owner != null ? (
          <canvas data-chart="incomeByTenureMedians"></canvas>
        ) : (
          <p class="muted">Add ACS variables <code>B25119_002E</code> and <code>B25119_003E</code> to the spreadsheet to populate this chart.</p>
        )}
        <figcaption class="muted">
          Owner-occupied vs. renter-occupied household income, county and state.
        </figcaption>
        <small class="source">Source: ACS 5-year 2024, Table B25119.</small>
      </figure>

      <figure class="card">
        <h3>Median Household Income by Age of Householder</h3>
        {county.income_median_25_44 != null ? (
          <canvas data-chart="incomeByAge"></canvas>
        ) : (
          <p class="muted">Add ACS variables <code>B19049_002E</code>–<code>B19049_005E</code> to the spreadsheet to populate this chart.</p>
        )}
        <figcaption class="muted">
          Median household income by age group of householder.
        </figcaption>
        <small class="source">Source: ACS 5-year 2024, Table B19049.</small>
      </figure>
    </div>

    <!-- Earners cluster: Figure 22 + Figure 32 (Household Size) side-by-side,
         with the affordability table (Table 7) below — keeps the two charts
         wide enough that their X-axis labels don't collide. -->
    <div class="grid grid-2">
      <figure class="card">
        <h3>Median Household Income by Number of Earners</h3>
        <canvas data-chart="earnersIncome"></canvas>
        <figcaption class="muted">
          Median household income for families with each earner count.
        </figcaption>
        <small class="source">Source: ACS 5-year 2024, Table S1903.</small>
      </figure>

      <figure class="card">
        <h3>Household Size</h3>
        <canvas data-chart="householdSize"></canvas>
        <figcaption class="muted">
          Distribution of households by number of people.
        </figcaption>
        <small class="source">Source: ACS 5-year 2024, Table S2501.</small>
      </figure>
    </div>

    <figure class="card">
      <h3>Income by Number of Earners</h3>
      <table class="earners-table">
        <thead>
          <tr>
            <th>Earners</th>
            <th>Share</th>
            <th>Median income</th>
            <th>Attainable monthly housing cost</th>
            <th>Attainable home</th>
          </tr>
        </thead>
        <tbody>
          {chartData.earnersTable.rows.map(([label, count, income]) => {
            const share = chartData.earnersTable.total_families
              ? (count ?? 0) / chartData.earnersTable.total_families * 100
              : null;
            // Attainable monthly housing cost = 30% of gross income / 12.
            const monthlyCost = (income != null && income > 0) ? (income * 0.30) / 12 : null;
            // Attainable home: 30% of income, 30-yr mortgage at 7%, 5% down, $2500 t&i, 0.5% PMI
            let attainable = null;
            if (income != null && income > 0) {
              const monthlyBudget = monthlyCost;
              const monthlyTaxIns = 2500 / 12;
              const monthlyRate = 0.07 / 12;
              const n = 360;
              const piFactor = (monthlyRate * Math.pow(1 + monthlyRate, n)) / (Math.pow(1 + monthlyRate, n) - 1);
              const principal = (monthlyBudget - monthlyTaxIns) / (piFactor + 0.005 / 12);
              attainable = principal > 0 ? principal / 0.95 : 0;
            }
            return (
              <tr>
                <th>{label}</th>
                <td>{share != null ? fmtPct(share) : '—'}</td>
                <td>{income != null ? fmtMoney(income) : '—'}</td>
                <td>{monthlyCost != null ? fmtMoney(monthlyCost) : '—'}</td>
                <td>{attainable != null ? fmtMoney(attainable) : '—'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <figcaption class="muted">
        Attainable monthly housing cost = 30% of gross income ÷ 12.
        Attainable home price assumes 30% housing budget, 30-yr mortgage at 7%, 5% down.
      </figcaption>
      <small class="source">Source: ACS 5-year 2024, Table S1903; affordability formula derived.</small>
    </figure>

