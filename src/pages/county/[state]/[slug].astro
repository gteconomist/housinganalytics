---
import Base from '../../../layouts/Base.astro';
import manifest from '../../../data/generated/manifest.json';
import { fmtMoney, fmtInt, fmtPct, fmtRatio } from '../../../lib/format.js';

// Generate one static page per county at build time.
export async function getStaticPaths() {
  const m = (await import('../../../data/generated/manifest.json')).default;
  return m.counties.map(c => ({
    params: { state: c.state_slug, slug: c.slug },
    props:  { geoid: c.geoid },
  }));
}

const { geoid } = Astro.props;
const county = (await import(`../../../data/generated/counties/${geoid}.json`)).default;
const state    = county._context.state;
const national = county._context.national;

// ──────────────────────────────────────────────────────────────────
// Pre-shape data for charts (so the client-side script just receives plain
// JSON in <script type="application/json"> tags and stays small).
// ──────────────────────────────────────────────────────────────────
function pct(part, whole) { return (whole && part != null) ? (part / whole) * 100 : 0; }

const tot_units    = county.units_total ?? 0;
const tot_occupied = county.tenure_total_occupied ?? 0;
const tot_renter   = county.tenure_renter_occupied ?? 0;
const tot_owner    = county.tenure_owner_occupied ?? 0;
const tot_pop      = county.population_total ?? 0;

const chartData = {
  // 1. Racial composition (county vs state)
  race: {
    labels: ['White', 'Black or African American', 'Asian', 'Two or more races', 'Other / NHPI / AIAN'],
    county: [
      pct(county.race_white,    tot_pop),
      pct(county.race_black,    tot_pop),
      pct(county.race_asian,    tot_pop),
      pct(county.race_two_plus, tot_pop),
      pct((county.race_other ?? 0) + (county.race_aian ?? 0) + (county.race_nhpi ?? 0), tot_pop),
    ],
    // For state context, build the same shares from the state agg fields:
    state: [],
  },

  // 2. Tenure
  tenure: {
    labels: ['Owner-occupied', 'Renter-occupied'],
    values: [
      pct(county.tenure_owner_occupied,  tot_occupied),
      pct(county.tenure_renter_occupied, tot_occupied),
    ],
    state: [
      state.homeownership_rate ?? 0,
      state.renter_rate ?? 0,
    ],
  },

  // 3. Structure type
  structure: {
    labels: ['SFD', 'SFA', '2 units', '3–4', '5–9', '10–19', '20–49', '50+', 'Mobile', 'Other'],
    values: [
      pct(county.structure_1_detached, tot_units),
      pct(county.structure_1_attached, tot_units),
      pct(county.structure_2,          tot_units),
      pct(county.structure_3_4,        tot_units),
      pct(county.structure_5_9,        tot_units),
      pct(county.structure_10_19,      tot_units),
      pct(county.structure_20_49,      tot_units),
      pct(county.structure_50_plus,    tot_units),
      pct(county.structure_mobile,     tot_units),
      pct(county.structure_other,      tot_units),
    ],
  },

  // 4. Year built
  yearBuilt: {
    labels: ['Pre-1940', '1940–59', '1960–79', '1980–99', '2000–09', '2010–19', '2020+'],
    values: [
      county.year_built_1939_earlier,
      county.year_built_1940_59,
      county.year_built_1960_79,
      county.year_built_1980_99,
      county.year_built_2000_09,
      county.year_built_2010_19,
      county.year_built_2020_plus,
    ],
  },

  // 5. Bedrooms vs household size (the "housing size mismatch")
  bedrooms: {
    labels: ['Studio', '1 BR', '2 BR', '3 BR', '4 BR', '5+ BR'],
    units:  [county.br_0, county.br_1, county.br_2, county.br_3, county.br_4, county.br_5_plus],
  },
  hhSize: {
    labels: ['1 person', '2 person', '3 person', '4+ person'],
    values: [county.hh_size_1, county.hh_size_2, county.hh_size_3, county.hh_size_4_plus],
  },

  // 6. Home value distribution
  homeValue: {
    labels: ['<$50K', '$50–99K', '$100–150K', '$150–200K', '$200–300K', '$300–500K', '$500K–1M', '$1M+'],
    values: [
      county.value_lt_50k, county.value_50_99k, county.value_100_150k, county.value_150_200k,
      county.value_200_300k, county.value_300_500k, county.value_500_1m, county.value_1m_plus,
    ],
  },

  // 7. Median rent by bedroom
  rentByBR: {
    labels: ['Studio', '1 BR', '2 BR', '3 BR', '4 BR', '5+ BR'],
    county: [county.rent_median_0br, county.rent_median_1br, county.rent_median_2br,
             county.rent_median_3br, county.rent_median_4br, county.rent_median_5br],
  },

  // 8. Renter cost burden
  renterBurden: {
    labels: ['<10%', '10–14%', '15–19%', '20–24%', '25–29%', '30–34%', '35–39%', '40–49%', '50%+'],
    values: [
      county.rent_burden_lt_10, county.rent_burden_10_14, county.rent_burden_15_19,
      county.rent_burden_20_24, county.rent_burden_25_29, county.rent_burden_30_34,
      county.rent_burden_35_39, county.rent_burden_40_49, county.rent_burden_50_plus,
    ],
  },

  // 9. Owner cost burden (B25106: by income band, 30%+ buckets) — quick view
  ownerBurden: {
    labels: ['<$20K', '$20–35K', '$35–50K', '$50–75K', '$75K+'],
    values: [
      county.cb_owner_30_plus_lt20k,   county.cb_owner_30_plus_20_35k,
      county.cb_owner_30_plus_35_50k, county.cb_owner_30_plus_50_75k,
      county.cb_owner_30_plus_75k_plus,
    ],
  },

  // 10. Tenure × age
  tenureAge: {
    labels: ['<35', '35–44', '45–54', '55–64', '65–74', '75–84', '85+'],
    owners: [
      county.owner_age_under35, county.owner_age_35_44, county.owner_age_45_54,
      county.owner_age_55_64, county.owner_age_65_74, county.owner_age_75_84, county.owner_age_85_plus,
    ],
    renters: [
      county.renter_age_under35, county.renter_age_35_44, county.renter_age_45_54,
      county.renter_age_55_64, county.renter_age_65_74, county.renter_age_75_84, county.renter_age_85_plus,
    ],
  },

  // 11. Owner vs Renter income distributions
  incomeByTenure: {
    labels: ['<$5K', '$5–10K', '$10–15K', '$15–20K', '$20–25K', '$25–35K', '$35–50K',
             '$50–75K', '$75–100K', '$100–150K', '$150K+'],
    owners: [
      county.oi_lt_5k, county.oi_5_10k, county.oi_10_15k, county.oi_15_20k, county.oi_20_25k,
      county.oi_25_35k, county.oi_35_50k, county.oi_50_75k, county.oi_75_100k, county.oi_100_150k,
      county.oi_150k_plus,
    ],
    renters: [
      county.ri_lt_5k, county.ri_5_10k, county.ri_10_15k, county.ri_15_20k, county.ri_20_25k,
      county.ri_25_35k, county.ri_35_50k, county.ri_50_75k, county.ri_75_100k, county.ri_100_150k,
      county.ri_150k_plus,
    ],
  },

  // 12. Education attainment
  education: {
    labels: ['<9th', '9–12 no dipl.', 'HS grad', 'Some college', "Assoc.", "Bachelor's", 'Graduate'],
    values: [
      county.edu_lt_9th, county.edu_9_12_no_diploma, county.edu_hs_grad,
      county.edu_some_college, county.edu_associates, county.edu_bachelors, county.edu_graduate,
    ],
  },
};

// Workforce housing range
const mhi = county.hh_income_median;
const workforceLow  = mhi ? mhi * 0.80 : null;
const workforceHigh = mhi ? mhi * 1.20 : null;

// HUD AMI (may be null if the HUD fetch step didn't run / failed). The page
// guards every reference so the section just collapses gracefully.
const hud = county.hud_ami;
---

<Base title={`${county.county_name}, ${county.state_name}`} county={county}>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="county-hero">
    <div class="container">
      <p class="eyebrow">{county.state_name} · GEOID {county.geoid}</p>
      <h1>{county.county_name}</h1>
      <p class="county-hero__lede muted">
        2024 ACS 5-year estimates · population {fmtInt(county.population_total)} ·
        {fmtInt(county.units_total)} housing units
      </p>

      <div class="kpis">
        <div class="kpi"><div class="kpi__label">Median household income</div>
          <div class="kpi__value">{fmtMoney(county.hh_income_median)}</div>
          <div class="kpi__delta muted">State {fmtMoney(state.hh_income_median)}</div></div>
        <div class="kpi"><div class="kpi__label">Median home value</div>
          <div class="kpi__value">{fmtMoney(county.value_median)}</div>
          <div class="kpi__delta muted">State {fmtMoney(state.value_median)}</div></div>
        <div class="kpi"><div class="kpi__label">Median gross rent</div>
          <div class="kpi__value">{fmtMoney(county.rent_median)}</div>
          <div class="kpi__delta muted">State {fmtMoney(state.rent_median)}</div></div>
        <div class="kpi"><div class="kpi__label">Homeownership rate</div>
          <div class="kpi__value">{fmtPct(county.homeownership_rate)}</div>
          <div class="kpi__delta muted">State {fmtPct(state.homeownership_rate)}</div></div>
        <div class="kpi"><div class="kpi__label">Renter cost-burden rate</div>
          <div class="kpi__value">{fmtPct(county.renter_cost_burden_rate)}</div>
          <div class="kpi__delta muted">≥30% of income</div></div>
        <div class="kpi"><div class="kpi__label">Owner cost-burden rate</div>
          <div class="kpi__value">{fmtPct(county.owner_cost_burden_rate)}</div>
          <div class="kpi__delta muted">≥30% of income</div></div>
        <div class="kpi"><div class="kpi__label">Homeowner vacancy</div>
          <div class="kpi__value">{fmtPct(county.homeowner_vacancy_rate)}</div>
          <div class="kpi__delta muted">Of owner-occupied + for-sale units</div></div>
        <div class="kpi"><div class="kpi__label">Rental vacancy</div>
          <div class="kpi__value">{fmtPct(county.rental_vacancy_rate)}</div>
          <div class="kpi__delta muted">Of renter-occupied + for-rent units</div></div>
        <div class="kpi"><div class="kpi__label">Overall vacancy</div>
          <div class="kpi__value">{fmtPct(county.vacancy_rate)}</div>
          <div class="kpi__delta muted">All housing units</div></div>
        <div class="kpi"><div class="kpi__label">Price-to-income ratio</div>
          <div class="kpi__value">{fmtRatio(county.price_to_income_ratio)}</div>
          <div class="kpi__delta muted">Affordable: 2.0–3.0</div></div>
      </div>
    </div>
  </section>

  <!-- ── 1. Community Profile ─────────────────────────────────────── -->
  <section class="container report-section">
    <header class="section-head">
      <p class="eyebrow">Section 1</p>
      <h2>Community Profile</h2>
      <p class="muted">Population, demographics, household composition, and income.</p>
    </header>

    <div class="grid grid-2">
      <figure class="card">
        <h3>Racial composition</h3>
        <canvas data-chart="race"></canvas>
        <figcaption class="muted">
          {county.county_name} compared with {county.state_name}.
        </figcaption>
      </figure>

      <figure class="card">
        <h3>Educational attainment (population 25+)</h3>
        <canvas data-chart="education"></canvas>
        <figcaption class="muted">
          {fmtPct(county.bachelors_plus_rate)} hold a bachelor's degree or higher
          (state: {fmtPct(state.bachelors_plus_rate)}).
        </figcaption>
      </figure>
    </div>

    <div class="grid grid-3">
      <div class="card">
        <h4>Households</h4>
        <p class="big-num">{fmtInt(county.hh_total_s1101)}</p>
        <p class="muted">Average size: {fmtRatio(county.hh_avg_size)} people</p>
      </div>
      <div class="card">
        <h4>Households with children</h4>
        <p class="big-num">{fmtInt(county.hh_with_children)}</p>
        <p class="muted">{fmtPct(pct(county.hh_with_children, county.hh_total_s1101))} of households</p>
      </div>
      <div class="card">
        <h4>Per-capita income</h4>
        <p class="big-num">{fmtMoney(county.per_capita_income)}</p>
        <p class="muted">Poverty rate: {fmtPct(county.poverty_rate)}</p>
      </div>
    </div>
  </section>

  <!-- ── 2. Residential Market Analysis ───────────────────────────── -->
  <section class="container report-section">
    <header class="section-head">
      <p class="eyebrow">Section 2</p>
      <h2>Residential Market Analysis</h2>
      <p class="muted">Housing stock characteristics — tenure, type, age, size, vacancy, rents.</p>
    </header>

    <div class="grid grid-2">
      <figure class="card">
        <h3>Tenure</h3>
        <canvas data-chart="tenure"></canvas>
        <figcaption class="muted">
          {fmtPct(county.homeownership_rate)} owner-occupied vs.
          state average {fmtPct(state.homeownership_rate)}.
        </figcaption>
      </figure>

      <figure class="card">
        <h3>Structure type</h3>
        <canvas data-chart="structure"></canvas>
        <figcaption class="muted">
          Single-family share {fmtPct(county.single_family_share)} ·
          Missing middle (2–19 units) {fmtPct(county.missing_middle_share)}.
        </figcaption>
      </figure>
    </div>

    <div class="grid grid-2">
      <figure class="card">
        <h3>Housing stock by decade</h3>
        <canvas data-chart="yearBuilt"></canvas>
        <figcaption class="muted">
          {fmtPct(county.aging_stock_share)} built before 1980 ·
          Median structure age {fmtRatio(county.structure_median_age)} yrs.
        </figcaption>
      </figure>

      <figure class="card">
        <h3>Housing size mismatch</h3>
        <canvas data-chart="sizeMismatch"></canvas>
        <figcaption class="muted">
          Compares the share of housing units by bedroom count against the share of households by size —
          the "housing size mismatch" chart from CEDR's housing studies.
        </figcaption>
      </figure>
    </div>

    <div class="grid grid-2">
      <figure class="card">
        <h3>Home value distribution</h3>
        <canvas data-chart="homeValue"></canvas>
        <figcaption class="muted">
          Owner-occupied homes by value bracket. Median: {fmtMoney(county.value_median)}.
        </figcaption>
      </figure>

      <figure class="card">
        <h3>Median rent by bedroom</h3>
        <canvas data-chart="rentByBR"></canvas>
        <figcaption class="muted">
          Overall median gross rent: {fmtMoney(county.rent_median)}.
        </figcaption>
      </figure>
    </div>

    <div class="grid grid-2">
      <figure class="card">
        <h3>Renters by age</h3>
        <canvas data-chart="renterAge"></canvas>
        <figcaption class="muted">Number of renter householders by age bracket.</figcaption>
      </figure>
      <figure class="card">
        <h3>Owners by age</h3>
        <canvas data-chart="ownerAge"></canvas>
        <figcaption class="muted">Number of owner householders by age bracket.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ── 3. Workforce Housing Needs Assessment ────────────────────── -->
  <section class="container report-section">
    <header class="section-head">
      <p class="eyebrow">Section 3</p>
      <h2>Workforce Housing Needs Assessment</h2>
      <p class="muted">Affordability, cost burden, and the housing options for households in the workforce income range.</p>
    </header>

    <div class="grid grid-2">
      <div class="card workforce">
        <h3>Workforce range — ACS median household income</h3>
        <div class="workforce__bands">
          <div><span class="muted">80% MHI</span><strong>{fmtMoney(workforceLow)}</strong></div>
          <div><span class="muted">100% MHI</span><strong>{fmtMoney(mhi)}</strong></div>
          <div><span class="muted">120% MHI</span><strong>{fmtMoney(workforceHigh)}</strong></div>
        </div>
        <p class="muted">
          County-wide median from ACS 5-year estimates. A household at 100% MHI in {county.county_name}
          should be able to afford a home up to roughly
          <strong id="aff-price-mhi">—</strong> (30% housing budget, default mortgage terms).
        </p>
      </div>

      <div class="card workforce">
        <h3>Workforce range — HUD Area Median Income</h3>
        {hud ? (
          <Fragment>
            <table class="ami-table">
              <thead>
                <tr><th></th><th>2-person</th><th>4-person</th></tr>
              </thead>
              <tbody>
                <tr><th>80% AMI</th>
                  <td>{fmtMoney(hud.ami_80_2p)}</td>
                  <td>{fmtMoney(hud.ami_80_4p)}</td></tr>
                <tr><th>100% AMI</th>
                  <td>{fmtMoney(hud.ami_100_2p)}</td>
                  <td>{fmtMoney(hud.ami_100_4p)}</td></tr>
                <tr><th>120% AMI</th>
                  <td>{fmtMoney(hud.ami_120_2p)}</td>
                  <td>{fmtMoney(hud.ami_120_4p)}</td></tr>
              </tbody>
            </table>
            <p class="muted">
              HUD FMR Area: <strong>{hud.fmr_area ?? '—'}</strong>. 80% AMI uses HUD's published
              Section 8 Low Income Limits; 100% is HUD MFI; 120% is the standard workforce convention.
            </p>
          </Fragment>
        ) : (
          <p class="muted">HUD AMI data not available for this county.</p>
        )}
      </div>
    </div>

    <div class="card affordability">
      <h3>Affordability calculator</h3>
      <p class="muted">Matches the methodology in the Columbus and Thomaston housing studies: housing costs should not exceed 30% of gross income.</p>
      <div class="aff-inputs">
        <label class="aff-basis">Income basis
          <select id="aff-basis">
            <option value="custom">Custom (type below)</option>
            <option value="mhi" selected>ACS median household income</option>
            {hud && (
              <Fragment>
                <option value="ami_80_2p">HUD AMI · 2-person · 80%</option>
                <option value="ami_100_2p">HUD AMI · 2-person · 100%</option>
                <option value="ami_120_2p">HUD AMI · 2-person · 120%</option>
                <option value="ami_80_4p">HUD AMI · 4-person · 80%</option>
                <option value="ami_100_4p">HUD AMI · 4-person · 100%</option>
                <option value="ami_120_4p">HUD AMI · 4-person · 120%</option>
              </Fragment>
            )}
          </select>
        </label>
        <label>Household income
          <input type="number" id="aff-income" value={Math.round(mhi ?? 50000)} step="1000" min="0" />
        </label>
        <label>Interest rate
          <input type="number" id="aff-rate" value="7.0" step="0.1" min="0" max="20" />%
        </label>
        <label>Down payment
          <input type="number" id="aff-down" value="5" step="1" min="0" max="100" />%
        </label>
        <label>Taxes &amp; insurance / yr
          <input type="number" id="aff-ti" value="2500" step="100" min="0" />
        </label>
      </div>
      <div class="aff-results">
        <div><span class="muted">Affordable monthly</span><strong id="aff-monthly">—</strong></div>
        <div><span class="muted">Affordable home price</span><strong id="aff-price">—</strong></div>
      </div>
    </div>

    <div class="grid grid-2">
      <figure class="card">
        <h3>Renter cost burden</h3>
        <canvas data-chart="renterBurden"></canvas>
        <figcaption class="muted">
          {fmtPct(county.renter_cost_burden_rate)} of renter households spend ≥30% of income on rent
          ({fmtPct(county.renter_severe_cost_burden_rate)} spend ≥50%).
        </figcaption>
      </figure>
      <figure class="card">
        <h3>Owner cost burden by income</h3>
        <canvas data-chart="ownerBurden"></canvas>
        <figcaption class="muted">
          {fmtPct(county.owner_cost_burden_rate)} of homeowners spend ≥30% of income on housing.
          Bars show counts of cost-burdened owners by income bracket.
        </figcaption>
      </figure>
    </div>

    <figure class="card">
      <h3>Household income — owners vs renters</h3>
      <canvas data-chart="incomeByTenure"></canvas>
      <figcaption class="muted">
        Distribution of household income for owner-occupied (navy) and renter-occupied (gold) households.
      </figcaption>
    </figure>
  </section>

  <!-- ── Methodology footnote ─────────────────────────────────────── -->
  <section class="container report-section">
    <details class="methodology">
      <summary>Methodology &amp; sources</summary>
      <p>
        All figures derive from the 2024 American Community Survey 5-year estimates. State and national
        comparisons are population-weighted aggregates of county-level estimates (an approximation; ACS
        publishes its own state and national medians which can differ slightly).
      </p>
      <p>
        The affordability calculator uses a 30% housing-budget rule with a 30-year mortgage. Defaults are
        7% interest, 5% down, $2,500/year taxes and insurance, and 0.5% PMI — adjustable above.
      </p>
      <p class="muted">
        Variables: {county.geoid} · pulled from <code>Full Housing Data Table.xlsx</code>.
      </p>
    </details>
  </section>
</Base>

<!-- ── Data + Chart.js init ──────────────────────────────────────── -->
<script type="application/json" id="county-data" set:html={JSON.stringify({ county, chartData })}></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
  const { county, chartData } = JSON.parse(document.getElementById('county-data').textContent);

  // Color palette pulled from CSS variables on the live element.
  const css = getComputedStyle(document.documentElement);
  const C = {
    navy:  css.getPropertyValue('--color-navy').trim(),
    gold:  css.getPropertyValue('--color-gold').trim(),
    teal:  css.getPropertyValue('--color-teal').trim(),
    blue:  css.getPropertyValue('--color-blue').trim(),
    lteal: css.getPropertyValue('--color-light-teal').trim(),
    purple: css.getPropertyValue('--color-purple').trim(),
    lime:  css.getPropertyValue('--color-lime').trim(),
    red:   css.getPropertyValue('--color-red').trim(),
    amber: css.getPropertyValue('--color-amber').trim(),
    sage:  css.getPropertyValue('--color-sage').trim(),
    char:  css.getPropertyValue('--color-charcoal').trim(),
  };
  const palette = [C.navy, C.gold, C.teal, C.blue, C.lteal, C.purple, C.lime, C.red, C.amber, C.char];

  Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
  Chart.defaults.color = C.char;
  Chart.defaults.borderColor = '#e6e2d2';

  const mk = (sel, cfg) => {
    const el = document.querySelector(`canvas[data-chart="${sel}"]`);
    if (!el) return;
    new Chart(el, cfg);
  };

  // Helpers
  const pctOpts = (max = undefined) => ({
    scales: {
      y: { beginAtZero: true, max, ticks: { callback: v => v + '%' } },
    },
    plugins: { legend: { position: 'top' } },
  });
  const countOpts = () => ({
    scales: { y: { beginAtZero: true } },
    plugins: { legend: { display: false } },
  });
  const moneyOpts = () => ({
    scales: { y: { beginAtZero: true, ticks: { callback: v => '$' + v.toLocaleString() } } },
    plugins: { legend: { display: false } },
  });

  // ── Charts ─────────────────────────────────────────────────────
  mk('race', {
    type: 'bar',
    data: {
      labels: chartData.race.labels,
      datasets: [{ data: chartData.race.county, backgroundColor: C.navy, borderRadius: 4 }],
    },
    options: {
      scales: { y: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' } } },
      plugins: { legend: { display: false } },
    },
  });

  mk('education', {
    type: 'bar',
    data: {
      labels: chartData.education.labels,
      datasets: [{ data: chartData.education.values, backgroundColor: C.gold, borderRadius: 4 }],
    },
    options: countOpts(),
  });

  mk('tenure', {
    type: 'doughnut',
    data: {
      labels: chartData.tenure.labels,
      datasets: [{ data: chartData.tenure.values, backgroundColor: [C.navy, C.gold] }],
    },
    options: { plugins: { legend: { position: 'bottom' } } },
  });

  mk('structure', {
    type: 'bar',
    data: {
      labels: chartData.structure.labels,
      datasets: [{ data: chartData.structure.values, backgroundColor: C.teal, borderRadius: 4 }],
    },
    options: pctOpts(),
  });

  mk('yearBuilt', {
    type: 'bar',
    data: {
      labels: chartData.yearBuilt.labels,
      datasets: [{ data: chartData.yearBuilt.values, backgroundColor: C.blue, borderRadius: 4 }],
    },
    options: countOpts(),
  });

  // Housing size mismatch: bedrooms vs household size on a unified percent axis.
  // Bedrooms: 0/1/2/3/4/5+ → align to household size buckets 1/2/3/4+ as the report does.
  // We render them as paired groups: BR distribution vs HH-size distribution.
  const brTotal = chartData.bedrooms.units.reduce((a,b) => a + (b||0), 0) || 1;
  const hhTotal = chartData.hhSize.values.reduce((a,b) => a + (b||0), 0) || 1;
  const brPct = chartData.bedrooms.units.map(v => (v||0)/brTotal*100);
  const hhPct = chartData.hhSize.values.map(v => (v||0)/hhTotal*100);
  mk('sizeMismatch', {
    type: 'bar',
    data: {
      labels: ['Studio / 1 person', '1 BR / 2 person', '2 BR / 3 person', '3+ BR / 4+ person'],
      datasets: [
        { label: 'Housing units (% by BR)', data: [brPct[0]+brPct[1], brPct[2], brPct[3], brPct[4]+brPct[5]], backgroundColor: C.navy, borderRadius: 4 },
        { label: 'Households (% by size)',  data: hhPct, backgroundColor: C.gold, borderRadius: 4 },
      ],
    },
    options: pctOpts(),
  });

  mk('homeValue', {
    type: 'bar',
    data: {
      labels: chartData.homeValue.labels,
      datasets: [{ data: chartData.homeValue.values, backgroundColor: C.purple, borderRadius: 4 }],
    },
    options: countOpts(),
  });

  mk('rentByBR', {
    type: 'bar',
    data: {
      labels: chartData.rentByBR.labels,
      datasets: [{ data: chartData.rentByBR.county, backgroundColor: C.teal, borderRadius: 4 }],
    },
    options: moneyOpts(),
  });

  mk('renterAge', {
    type: 'bar',
    data: {
      labels: chartData.tenureAge.labels,
      datasets: [{ data: chartData.tenureAge.renters, backgroundColor: C.gold, borderRadius: 4 }],
    },
    options: countOpts(),
  });
  mk('ownerAge', {
    type: 'bar',
    data: {
      labels: chartData.tenureAge.labels,
      datasets: [{ data: chartData.tenureAge.owners, backgroundColor: C.navy, borderRadius: 4 }],
    },
    options: countOpts(),
  });

  mk('renterBurden', {
    type: 'bar',
    data: {
      labels: chartData.renterBurden.labels,
      datasets: [{ data: chartData.renterBurden.values,
        backgroundColor: chartData.renterBurden.labels.map((_, i) => i < 5 ? C.lteal : (i < 8 ? C.amber : C.red)),
        borderRadius: 4 }],
    },
    options: countOpts(),
  });
  mk('ownerBurden', {
    type: 'bar',
    data: {
      labels: chartData.ownerBurden.labels,
      datasets: [{ data: chartData.ownerBurden.values, backgroundColor: C.amber, borderRadius: 4 }],
    },
    options: countOpts(),
  });

  mk('incomeByTenure', {
    type: 'bar',
    data: {
      labels: chartData.incomeByTenure.labels,
      datasets: [
        { label: 'Owners',  data: chartData.incomeByTenure.owners,  backgroundColor: C.navy,  borderRadius: 4 },
        { label: 'Renters', data: chartData.incomeByTenure.renters, backgroundColor: C.gold,  borderRadius: 4 },
      ],
    },
    options: { ...countOpts(), plugins: { legend: { position: 'top' } } },
  });

  // ── Affordability calculator ──────────────────────────────────
  const aff = {
    basis:   document.getElementById('aff-basis'),
    income:  document.getElementById('aff-income'),
    rate:    document.getElementById('aff-rate'),
    down:    document.getElementById('aff-down'),
    ti:      document.getElementById('aff-ti'),
    monthly: document.getElementById('aff-monthly'),
    price:   document.getElementById('aff-price'),
    priceMhi: document.getElementById('aff-price-mhi'),
  };
  // Income basis lookup table — populates the income input when the user
  // changes the dropdown. "custom" leaves whatever they typed alone.
  const basisValues = {
    mhi: county.hh_income_median ?? null,
    ami_80_2p:  county.hud_ami?.ami_80_2p  ?? null,
    ami_100_2p: county.hud_ami?.ami_100_2p ?? null,
    ami_120_2p: county.hud_ami?.ami_120_2p ?? null,
    ami_80_4p:  county.hud_ami?.ami_80_4p  ?? null,
    ami_100_4p: county.hud_ami?.ami_100_4p ?? null,
    ami_120_4p: county.hud_ami?.ami_120_4p ?? null,
  };
  if (aff.basis) {
    aff.basis.addEventListener('change', () => {
      const v = basisValues[aff.basis.value];
      if (v != null) { aff.income.value = Math.round(v); update(); }
    });
    // Typing in the income field switches the dropdown to "custom" so it's clear
    // what's driving the number.
    aff.income.addEventListener('input', () => { aff.basis.value = 'custom'; });
  }
  function recalc(income, rate, downPct, ti) {
    const monthlyBudget = (income * 0.30) / 12;
    const monthlyTaxIns = ti / 12;
    const monthlyRate = (rate / 100) / 12;
    const n = 360;
    const pmiMonthlyRate = 0.005 / 12;
    const piFactor = monthlyRate === 0
      ? (1 / n)
      : (monthlyRate * Math.pow(1 + monthlyRate, n)) / (Math.pow(1 + monthlyRate, n) - 1);
    const principal = (monthlyBudget - monthlyTaxIns) / (piFactor + pmiMonthlyRate);
    const price = principal > 0 ? principal / (1 - downPct / 100) : 0;
    return { monthlyBudget, price: Math.max(0, price) };
  }
  function update() {
    const inc  = parseFloat(aff.income.value)  || 0;
    const rate = parseFloat(aff.rate.value)    || 0;
    const dp   = parseFloat(aff.down.value)    || 0;
    const ti   = parseFloat(aff.ti.value)      || 0;
    const { monthlyBudget, price } = recalc(inc, rate, dp, ti);
    aff.monthly.textContent = '$' + Math.round(monthlyBudget).toLocaleString();
    aff.price.textContent   = '$' + Math.round(price).toLocaleString();
  }
  ['income', 'rate', 'down', 'ti'].forEach(k => aff[k]?.addEventListener('input', update));
  update();
  // Anchor: home price at MHI
  if (aff.priceMhi && county.hh_income_median) {
    const { price } = recalc(county.hh_income_median, 7, 5, 2500);
    aff.priceMhi.textContent = '$' + Math.round(price).toLocaleString();
  }
</script>

