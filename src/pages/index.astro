---
import Base from '../layouts/Base.astro';
import hsiData from '../data/generated/hsi.json';
import travis from '../data/generated/counties/48453.json';

const t = hsiData.counties['48453'];

const FIPS = {'01':'AL','02':'AK','04':'AZ','05':'AR','06':'CA','08':'CO','09':'CT','10':'DE','11':'DC','12':'FL','13':'GA','15':'HI','16':'ID','17':'IL','18':'IN','19':'IA','20':'KS','21':'KY','22':'LA','23':'ME','24':'MD','25':'MA','26':'MI','27':'MN','28':'MS','29':'MO','30':'MT','31':'NE','32':'NV','33':'NH','34':'NJ','35':'NM','36':'NY','37':'NC','38':'ND','39':'OH','40':'OK','41':'OR','42':'PA','44':'RI','45':'SC','46':'SD','47':'TN','48':'TX','49':'UT','50':'VT','51':'VA','53':'WA','54':'WV','55':'WI','56':'WY','72':'PR'};

const agg = {};
for (const [g, r] of Object.entries(hsiData.counties)) {
  const f = g.slice(0, 2);
  if (FIPS[f]) { (agg[f] ||= []).push(r.score); }
}
const states = Object.entries(agg)
  .map(([f, a]) => ({ abbr: FIPS[f], mean: a.reduce((x, y) => x + y, 0) / a.length }))
  .sort((a, b) => b.mean - a.mean);

const hx = (v) => v.toString(16).padStart(2, '0');
const L = (a, b, tt) => Math.round(a + (b - a) * tt);
function ramp(tt) {
  const c0 = [239, 233, 226], c1 = [247, 148, 30], c2 = [58, 36, 8];
  let r, g, b;
  if (tt < 0.5) { const u = tt / 0.5; r = L(c0[0], c1[0], u); g = L(c0[1], c1[1], u); b = L(c0[2], c1[2], u); }
  else { const u = (tt - 0.5) / 0.5; r = L(c1[0], c2[0], u); g = L(c1[1], c2[1], u); b = L(c1[2], c2[2], u); }
  return '#' + hx(r) + hx(g) + hx(b);
}
const COLS = 8, TW = 96, TH = 58, GAP = 7;
const rows = Math.ceil(states.length / COLS);
const W = COLS * TW + (COLS - 1) * GAP, H = rows * TH + (rows - 1) * GAP;
let tiles = '';
states.forEach((s, i) => {
  const c = i % COLS, r = Math.floor(i / COLS), x = c * (TW + GAP), y = r * (TH + GAP);
  const tt = Math.min(1, s.mean / 100), f = ramp(tt), dk = tt > 0.42, tx = dk ? '#fff' : '#231f20';
  tiles += `<g><rect x="${x}" y="${y}" width="${TW}" height="${TH}" rx="8" fill="${f}"/><text x="${x + TW / 2}" y="${y + 24}" text-anchor="middle" font-weight="700" font-size="15" fill="${tx}">${s.abbr}</text><text x="${x + TW / 2}" y="${y + 41}" text-anchor="middle" font-size="12" fill="${tx}" opacity=".85">${s.mean.toFixed(0)}</text></g>`;
});
const gridSvg = `<svg viewBox="0 0 ${W} ${H}" width="100%" style="max-width:${W}px" role="img" aria-label="U.S. states shaded by average Housing Stress Index">${tiles}</svg>`;

const money = (v) => '$' + Math.round(v).toLocaleString();
const pct = (v) => Math.round(v) + '%';
const badgeColor = ramp(Math.min(1, t.score / 100));
const most = states[0], least = states[states.length - 1];
const REQUEST = 'mailto:alfie@economicimpact.com?subject=housinganalytics.org%20access%20request';
---
<Base marketing
      title="housinganalytics.org — housing analysis for every U.S. community"
      description="Full housing-study profiles, rankings, and a defensible Housing Stress Index for all 3,222 counties and 4,814 cities — built from federal data, for economic development and housing agencies.">

  <section class="hp-hero">
    <div>
      <div class="hp-eyebrow">For economic development &amp; housing agencies</div>
      <h1>The housing picture for every U.S. community — ready to defend.</h1>
      <p class="hp-lede">Full housing-study profiles, rankings, and a single defensible stress score for all 3,222 counties and 4,814 cities — built entirely from federal data. The ACS backbone of your next housing needs assessment, grant narrative, or council briefing, in seconds instead of days.</p>
      <div class="hp-ctas"><a class="hp-req" href={REQUEST}>Request access →</a><a class="hp-ghost" href="/county/texas/travis-county">See a sample profile</a></div>
      <div class="hp-trust">Currently available to <b>select partners</b>. Subscriptions opening soon.</div>
    </div>
    <div class="hp-pcard">
      <div class="hp-pcard__top"><div><div class="nm">{travis.county_name}, {travis.state_name}</div><div class="st">Pop. {Math.round(travis.population_total).toLocaleString()} · ACS 2024 5-year</div></div><div class="hp-pcard__tag">Sample profile</div></div>
      <div class="hp-badge"><div class="sc" style={`background:${badgeColor}`}>{t.score}</div><div><div class="lbl">Housing Stress Index</div><div class="sub">More stressed than {t.score}% of counties · #{t.rank.toLocaleString()} of 3,222</div></div></div>
      <div class="hp-kpis">
        <div class="hp-kpi"><div class="k">Median home value</div><div class="v">{money(travis.value_median)}</div></div>
        <div class="hp-kpi"><div class="k">Median income</div><div class="v">{money(travis.hh_income_median)}</div></div>
        <div class="hp-kpi"><div class="k">Median rent</div><div class="v">{money(travis.rent_median)}</div></div>
        <div class="hp-kpi"><div class="k">Renter cost burden</div><div class="v">{pct(travis.renter_cost_burden_rate)}</div></div>
        <div class="hp-kpi"><div class="k">Homeownership</div><div class="v">{pct(travis.homeownership_rate)}</div></div>
        <div class="hp-kpi"><div class="k">Price-to-income</div><div class="v">{travis.price_to_income_ratio.toFixed(1)}×</div></div>
      </div>
      <div class="hp-pcard__foot"><span>Full profile: market · affordability · workforce</span><span>Export: Excel · Word · PDF</span></div>
    </div>
  </section>

  <section class="hp-aud">
    <div class="container hp-aud__in">
      <div class="big">Purpose-built for the people who write housing studies, grant applications, and comprehensive plans.</div>
      <div class="who"><span class="chip">Economic development orgs</span><span class="chip">Housing authorities</span><span class="chip">Planners &amp; COGs</span></div>
    </div>
  </section>

  <section class="container hp-sec">
    <div class="hp-kick"><span class="no">01</span><h2>Everything a housing study needs, already assembled</h2></div>
    <div class="hp-cards">
      <div class="hp-card"><div class="big">3,222 + 4,814</div><h3>Counties and cities</h3><p>A full profile for every county and every city over 5,000 people — market, affordability, and workforce, structured like a housing study.</p></div>
      <div class="hp-card"><div class="big" style="color:var(--accent-strong)">0–100</div><h3>The Housing Stress Index</h3><p>One defensible number your council briefing or grant intro can lead with — computed for every place, fully documented.</p></div>
      <div class="hp-card"><div class="big">Excel · Word · PDF</div><h3>Client-ready output</h3><p>Export any profile, or generate a custom multi-vintage ACS data workbook for any geography.</p></div>
    </div>
  </section>

  <section class="container hp-sec hp-sec--tight">
    <div class="hp-hsi">
      <div>
        <div class="hp-eyebrow hp-eyebrow--light">The differentiator</div>
        <h2>A single, defensible measure of housing stress.</h2>
        <p>The Housing Stress Index blends renter &amp; owner cost burden, rent-to-income, and price-to-income into one 0–100 score — national z-scores, transparent weights, published methodology. The headline number for your next brief.</p>
        <a class="hp-btn" href="/analysis/housing-stress-index">Read the methodology →</a>
      </div>
      <div>
        <div class="hp-exrow"><div class="s" style="background:#3a2408">100</div><div><b>Monroe County, FL</b><small>Most housing-stressed county</small></div></div>
        <div class="hp-exrow"><div class="s" style={`background:${badgeColor}`}>{t.score}</div><div><b>Travis County, TX</b><small>#{t.rank.toLocaleString()} of 3,222</small></div></div>
        <div class="hp-exrow"><div class="s" style="background:#9c867a">18</div><div><b>Low-stress rural county</b><small>Bottom of the national range</small></div></div>
      </div>
    </div>
  </section>

  <section class="hp-mapsec">
    <div class="container">
      <h2>The Index, coast to coast</h2>
      <p>Every state shaded by its average county stress score — most stressed: {most.abbr} ({most.mean.toFixed(0)}), least: {least.abbr} ({least.mean.toFixed(0)}).</p>
      <div class="hp-gridwrap" set:html={gridSvg}></div>
      <div class="hp-legend"><span>Calm</span><div class="bar"></div><span>Stressed</span></div>
    </div>
  </section>

  <section class="hp-cred">
    <div class="container">
      <div class="t">Built entirely from official federal data</div>
      <div class="s"><a href="/data">Census ACS</a><a href="/data">BLS QCEW</a><a href="/data">BLS OEWS</a><a href="/data">HUD</a><a href="/data">Census Gazetteer</a></div>
    </div>
  </section>

  <section class="container hp-request">
    <h2>Request access.</h2>
    <p>Tell us about your organization and we'll get you set up.</p>
    <a class="hp-req hp-req--lg" href={REQUEST}>Request access →</a>
    <div class="note">Invite-only today · subscriptions opening soon</div>
  </section>

</Base>

<style>
  h1 { font-size: 50px; line-height: 1.06; letter-spacing: -.03em; margin: 14px 0 16px; font-weight: 800; color: var(--text-primary); }
  h2 { letter-spacing: -.02em; }
  .hp-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-strong); }
  .hp-eyebrow--light { color: var(--accent); }

  .hp-hero { max-width: 1140px; margin: 0 auto; padding: 60px 24px 50px; display: grid; grid-template-columns: 1.05fr .95fr; gap: 48px; align-items: center; }
  .hp-lede { font-size: 18px; color: var(--text-muted); margin: 0 0 26px; max-width: 52ch; }
  .hp-ctas { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .hp-req { background: var(--accent); color: #231603; padding: 13px 22px; border-radius: 11px; font-weight: 700; font-size: 15px; text-decoration: none; }
  .hp-req:hover { background: var(--accent-strong); }
  .hp-ghost { border: 1.5px solid var(--color-hair); background: #fff; padding: 12px 20px; border-radius: 11px; font-weight: 600; font-size: 15px; color: var(--text-body); text-decoration: none; }
  .hp-trust { margin-top: 16px; font-size: 13px; color: var(--text-muted); }
  .hp-trust b { color: var(--text-body); }

  .hp-pcard { border: 1px solid var(--color-hair); border-radius: 18px; box-shadow: 0 24px 60px rgba(60,42,16,.12); overflow: hidden; background: #fff; }
  .hp-pcard__top { padding: 18px 20px; border-bottom: 1px solid var(--color-hair); display: flex; justify-content: space-between; align-items: center; }
  .hp-pcard__top .nm { font-weight: 800; font-size: 16px; }
  .hp-pcard__top .st { color: var(--text-muted); font-size: 12.5px; }
  .hp-pcard__tag { font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent-strong); background: #fde8cc; padding: 3px 9px; border-radius: 6px; }
  .hp-badge { margin: 18px 20px 6px; display: flex; align-items: center; gap: 14px; background: var(--color-panel); border-radius: 12px; padding: 14px 16px; }
  .hp-badge .sc { width: 56px; height: 56px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 23px; color: #fff; flex: none; }
  .hp-badge .lbl { font-weight: 700; font-size: 14px; }
  .hp-badge .sub { color: var(--text-muted); font-size: 12.5px; }
  .hp-kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--color-hair); margin-top: 14px; }
  .hp-kpi { background: #fff; padding: 13px 20px; }
  .hp-kpi .k { font-size: 11.5px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .04em; }
  .hp-kpi .v { font-weight: 800; font-size: 18px; margin-top: 2px; }
  .hp-pcard__foot { padding: 11px 20px; font-size: 12px; color: var(--text-muted); border-top: 1px solid var(--color-hair); display: flex; justify-content: space-between; }

  .hp-aud { background: var(--color-panel); border-top: 1px solid var(--color-hair); border-bottom: 1px solid var(--color-hair); padding: 40px 0; }
  .hp-aud__in { display: flex; gap: 40px; align-items: center; flex-wrap: wrap; }
  .hp-aud .big { font-size: 22px; font-weight: 700; letter-spacing: -.01em; max-width: 32ch; }
  .who { display: flex; gap: 10px; flex-wrap: wrap; }
  .chip { background: #fff; border: 1px solid var(--color-hair); border-radius: 999px; padding: 8px 15px; font-size: 13.5px; font-weight: 600; }

  .hp-sec { padding: 62px 24px; }
  .hp-sec--tight { padding-top: 0; }
  .hp-kick { display: flex; align-items: baseline; gap: 14px; margin-bottom: 26px; }
  .hp-kick .no { font-size: 14px; font-weight: 800; color: var(--accent-strong); }
  .hp-kick h2 { font-size: 29px; margin: 0; }
  .hp-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
  .hp-card { border: 1px solid var(--color-hair); border-radius: 14px; padding: 24px; background: #fff; }
  .hp-card .big { font-size: 25px; font-weight: 800; letter-spacing: -.02em; margin-bottom: 6px; color: var(--text-primary); }
  .hp-card h3 { margin: 0 0 8px; font-size: 17px; }
  .hp-card p { margin: 0; color: var(--text-muted); font-size: 14.5px; }

  .hp-hsi { background: var(--color-navy); color: #fff; border-radius: 20px; padding: 44px; display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center; }
  .hp-hsi h2 { font-size: 29px; margin: 6px 0 12px; }
  .hp-hsi p { color: #cbc9c5; font-size: 15px; margin: 0 0 18px; }
  .hp-btn { display: inline-block; background: var(--accent); color: #231603; font-weight: 700; padding: 11px 18px; border-radius: 10px; font-size: 14px; text-decoration: none; }
  .hp-exrow { display: flex; align-items: center; gap: 13px; background: rgba(255,255,255,.06); border-radius: 11px; padding: 11px 15px; margin-bottom: 9px; }
  .hp-exrow .s { width: 46px; height: 46px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: #fff; flex: none; }
  .hp-exrow b { font-size: 14.5px; }
  .hp-exrow small { color: #b4b1ab; display: block; font-size: 12px; }

  .hp-mapsec { padding: 56px 0; text-align: center; }
  .hp-mapsec h2 { font-size: 27px; margin: 0 0 6px; }
  .hp-mapsec p { color: var(--text-muted); margin: 0 0 24px; font-size: 15px; }
  .hp-gridwrap { display: flex; justify-content: center; }
  .hp-legend { display: flex; gap: 9px; align-items: center; justify-content: center; font-size: 12.5px; color: var(--text-muted); margin-top: 16px; }
  .hp-legend .bar { width: 160px; height: 9px; border-radius: 6px; background: linear-gradient(90deg,#efe9e2,#f7941e,#3a2408); }

  .hp-cred { background: var(--color-panel); border-top: 1px solid var(--color-hair); border-bottom: 1px solid var(--color-hair); padding: 28px 0; text-align: center; }
  .hp-cred .t { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); font-weight: 700; margin-bottom: 12px; }
  .hp-cred .s { display: flex; gap: 28px; justify-content: center; flex-wrap: wrap; font-weight: 700; color: var(--text-body); font-size: 15.5px; }
  .hp-cred .s a { color: var(--text-body); text-decoration: none; }
  .hp-cred .s a:hover { color: var(--accent-strong); }

  .hp-request { padding: 74px 24px; text-align: center; }
  .hp-request h2 { font-size: 38px; letter-spacing: -.025em; margin: 0 0 12px; }
  .hp-request p { color: var(--text-muted); font-size: 17px; margin: 0 auto 24px; max-width: 52ch; }
  .hp-req--lg { font-size: 16px; padding: 14px 26px; }
  .hp-request .note { margin-top: 14px; font-size: 13px; color: var(--text-muted); }

  @media (max-width: 820px) {
    .hp-hero { grid-template-columns: 1fr; gap: 34px; }
    h1 { font-size: 37px; }
    .hp-cards { grid-template-columns: 1fr; }
    .hp-hsi { grid-template-columns: 1fr; padding: 28px; }
  }
</style>
