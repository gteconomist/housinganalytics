---
import Base from '../layouts/Base.astro';
import manifest from '../data/generated/manifest.json';
import { fmtInt } from '../lib/format.js';
---

<Base title="housinganalytics.org — ACS housing data for every U.S. county"
      description="County-level housing data for economic-development analysts, drawn from the American Community Survey.">

  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">housinganalytics.org</p>
      <h1>Housing data for every U.S. county, ready for your next study.</h1>
      <p class="hero__lede">
        County profiles drawn from the American Community Survey, formatted for economic-development
        analysts. {fmtInt(manifest.county_count)} counties · 50 states, plus D.C. and Puerto Rico ·
        2024 ACS 5-year estimates.
      </p>

      <form class="search" role="search" data-county-search>
        <input
          type="search"
          name="q"
          placeholder="Search a county — e.g. Muscogee, Upson, Cook…"
          autocomplete="off"
          aria-label="Search counties" />
        <ul class="search__results" hidden></ul>
      </form>
    </div>
  </section>

  <section class="container">
    <h2>What you can do here</h2>
    <p class="section-lede muted">
      Three ways to work with the same underlying ACS data set — pulled into the shape an
      economic-development analyst actually needs.
    </p>

    <ul class="feature-list">
      <li class="feature">
        <p class="feature__eyebrow">County profiles</p>
        <h3><a href="#" data-feature-link="counties">A full housing profile for any of {fmtInt(manifest.county_count)} counties</a></h3>
        <p>
          Search a county above to open its profile. Each one is structured to mirror the three
          sections of a typical housing study — Community Profile, Residential Market Analysis,
          and Workforce Housing Needs Assessment — plus a parametric affordability calculator
          you can adjust on the page.
        </p>
        <p class="feature__hint muted">Use the search box at the top of the page.</p>
      </li>

      <li class="feature">
        <p class="feature__eyebrow">Compare</p>
        <h3><a href="/compare">Side-by-side comparison of 2–6 counties</a></h3>
        <p>
          Pick a handful of counties and see every metric from the profile lined up next to
          each other. The URL preserves your selection, so you can share or bookmark a specific
          comparison.
        </p>
        <p class="feature__hint"><a href="/compare">Open the compare tool →</a></p>
      </li>

      <li class="feature">
        <p class="feature__eyebrow">Rankings</p>
        <h3><a href="/rankings">Sort every U.S. county on any metric</a></h3>
        <p>
          Rank all 3,222 counties on any variable in the data set — median rent, vacancy rate,
          cost-burdened share, owner-occupied share, and so on. Filter by state or population
          tier, then export the current view to CSV.
        </p>
        <p class="feature__hint"><a href="/rankings">Open the rankings explorer →</a></p>
      </li>
    </ul>

    <p class="coming-soon muted">
      <strong>Coming next:</strong> a national map view, a place-name lookup (cities and CDPs
      resolved to their county), BLS QCEW wage and employment overlays, and one-click Word/PDF
      export of any county profile.
    </p>
  </section>
</Base>

<script type="module" define:vars={{ counties: manifest.counties }}>
  // Lightweight typeahead.
  const form  = document.querySelector('[data-county-search]');
  const input = form.querySelector('input');
  const out   = form.querySelector('.search__results');

  function render(matches) {
    if (!matches.length) { out.hidden = true; out.innerHTML = ''; return; }
    out.hidden = false;
    out.innerHTML = matches.slice(0, 8).map(c => `
      <li><a href="/county/${c.state_slug}/${c.slug}">
        <span>${c.name}</span>
        <span class="muted">${c.state}</span>
      </a></li>
    `).join('');
  }

  input.addEventListener('input', e => {
    const q = e.target.value.trim().toLowerCase();
    if (q.length < 2) return render([]);
    render(counties.filter(c =>
      c.name.toLowerCase().includes(q) ||
      c.state.toLowerCase().includes(q)
    ));
  });

  input.addEventListener('blur', () => setTimeout(() => render([]), 200));

  // "County profiles" feature headline scrolls back to the search box and focuses it.
  document.querySelectorAll('[data-feature-link="counties"]').forEach(el => {
    el.addEventListener('click', e => {
      e.preventDefault();
      input.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => input.focus(), 350);
    });
  });
</script>

<style>
  .hero {
    background: var(--bg-section);
    padding: var(--space-9) 0 var(--space-7);
    border-bottom: 1px solid var(--border-soft);
  }
  .hero h1 { max-width: 18ch; margin-bottom: var(--space-4); }
  .hero__lede { max-width: 60ch; font-size: var(--fs-md); color: var(--text-muted); margin-bottom: var(--space-6); }

  .search { position: relative; max-width: 560px; }
  .search input {
    width: 100%;
    padding: var(--space-4) var(--space-5);
    font-size: var(--fs-md);
    font-family: inherit;
    border: 2px solid var(--color-navy);
    border-radius: var(--radius-md);
    background: var(--bg-page);
    box-shadow: var(--shadow-soft);
  }
  .search input:focus {
    outline: 3px solid var(--color-gold);
    outline-offset: 1px;
  }
  .search__results {
    position: absolute; top: 100%; left: 0; right: 0;
    list-style: none; margin: var(--space-2) 0 0; padding: 0;
    background: var(--bg-page);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    z-index: 10;
  }
  .search__results li { border-bottom: 1px solid var(--border-soft); }
  .search__results li:last-child { border-bottom: none; }
  .search__results a {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: var(--space-3) var(--space-4);
    text-decoration: none; color: var(--text-body);
  }
  .search__results a:hover { background: var(--bg-section); }

  .container > h2 { margin: var(--space-7) 0 var(--space-3); }
  .section-lede { max-width: 70ch; margin: 0 0 var(--space-6); font-size: var(--fs-md); }

  .feature-list {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-5);
  }
  .feature {
    padding: var(--space-5) var(--space-5) var(--space-4);
    border: 1px solid var(--border-soft);
    border-left: 4px solid var(--color-gold);
    background: var(--bg-card);
  }
  .feature__eyebrow {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-navy);
    font-weight: var(--fw-medium);
    margin: 0 0 var(--space-2);
  }
  .feature h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-lg);
    line-height: 1.25;
  }
  .feature h3 a { color: var(--text-body); text-decoration: none; }
  .feature h3 a:hover { color: var(--color-navy); text-decoration: underline; }
  .feature p { margin: 0 0 var(--space-3); }
  .feature__hint { font-size: var(--fs-sm); margin-top: var(--space-2); }
  .feature__hint a { color: var(--color-navy); font-weight: var(--fw-medium); }

  .coming-soon {
    margin: var(--space-7) 0 var(--space-7);
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--border-soft);
    font-size: var(--fs-sm);
    max-width: 80ch;
  }
  .coming-soon strong { color: var(--color-navy); }
</style>
