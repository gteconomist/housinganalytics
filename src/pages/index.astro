---
import Base from '../layouts/Base.astro';
import manifest from '../data/generated/manifest.json';
import { fmtInt } from '../lib/format.js';

const countyCount = manifest.county_count;
const placeCount  = manifest.place_count ?? 0;
const placesVintage = manifest.places_vintage ?? 'ACS 5-year estimates';
---

<Base title="housinganalytics.org — ACS housing data for every U.S. county"
      description="County- and city-level housing data for economic-development analysts, drawn from the American Community Survey, BLS QCEW, BLS OEWS, and HUD.">

  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">housinganalytics.org</p>
      <h1>Housing data for every U.S. county and city, ready for your next study.</h1>
      <p class="hero__lede">
        housinganalytics.org turns the American Community Survey — and the federal labor and
        housing data sets that go with it — into the figures, tables, and plain-language
        summaries an economic-development analyst would otherwise spend days assembling per
        community.
      </p>
      <p class="hero__lede">
        Every page is structured the way a housing study is structured: a Community Profile,
        a Residential Market Analysis, and a Workforce Housing Needs Assessment, with industry
        and occupation wage detail layered in. {fmtInt(countyCount)} counties, {fmtInt(placeCount)}
        cities and towns, all 50 states plus D.C. and Puerto Rico, refreshed annually as new
        ACS, BLS, and HUD vintages publish.
      </p>
    </div>
  </section>

  <section class="container">
    <h2>What you can do here</h2>
    <p class="section-lede muted">
      The same underlying data set, surfaced six different ways — pulled into the shape an
      economic-development analyst actually needs.
    </p>

    <ul class="feature-list">
      <li class="feature">
        <p class="feature__eyebrow">County profiles</p>
        <h3><a href="/counties">A full housing profile for any of {fmtInt(countyCount)} counties</a></h3>
        <p>
          KPI tiles, a Community Data Summary table, tenure and stock breakdowns, value and rent
          distributions, cost-burden detail, and a parametric affordability calculator you can
          adjust on the page. Includes BLS QCEW industry employment and wages and BLS OEWS
          occupation wages with affordability tied to each.
        </p>
        <p class="feature__hint"><a href="/counties">Open the county search →</a></p>
      </li>

      <li class="feature">
        <p class="feature__eyebrow">City profiles</p>
        <h3><a href="/cities">A housing profile for any of {fmtInt(placeCount)} cities and towns</a></h3>
        <p>
          Demographics, housing stock, tenure, costs, rent and value distributions, cost burden,
          and the same parametric affordability calculator at the Census place geography. HUD AMI
          is inherited from the parent county. {placesVintage}.
        </p>
        <p class="feature__hint"><a href="/cities">Open the city search →</a></p>
      </li>

      <li class="feature">
        <p class="feature__eyebrow">Compare</p>
        <h3><a href="/compare">Side-by-side comparison of 2–6 counties</a></h3>
        <p>
          Pick a handful of counties and see every metric from the profile lined up next to
          each other — KPI strip, Community Data Summary, single-bar charts, and grouped or
          small-multiple distributions. The URL preserves your selection so you can share or
          bookmark a specific comparison.
        </p>
        <p class="feature__hint"><a href="/compare">Open the compare tool →</a></p>
      </li>

      <li class="feature">
        <p class="feature__eyebrow">Rankings</p>
        <h3><a href="/rankings">Sort every U.S. county on any metric</a></h3>
        <p>
          Rank all {fmtInt(countyCount)} counties on any variable in the data set — median rent,
          vacancy rate, cost-burdened share, owner-occupied share, and dozens more. Filter by
          state or population tier, see the top 10 as a chart, and export the current view to CSV.
        </p>
        <p class="feature__hint"><a href="/rankings">Open the rankings explorer →</a></p>
      </li>

      <li class="feature">
        <p class="feature__eyebrow">National map</p>
        <h3><a href="/map">Color every county on any metric</a></h3>
        <p>
          A choropleth of all {fmtInt(countyCount)} counties — pick a metric, zoom into a single
          state, switch between national and within-state color scales, hover for values, click
          through to a profile. Alaska and Hawaii are inset.
        </p>
        <p class="feature__hint"><a href="/map">Open the map →</a></p>
      </li>

      <li class="feature">
        <p class="feature__eyebrow">Export</p>
        <h3>One-click Excel &amp; PDF on every profile</h3>
        <p>
          Each county profile carries a download bar at the top. Pull the full data set as an
          Excel workbook, or save the rendered profile as a client-ready PDF — chart images, KPI
          tiles, tables, and footnotes all preserved. Individual charts also export to PNG.
        </p>
        <p class="feature__hint muted">Look for the download bar above the KPI tiles.</p>
      </li>
    </ul>
  </section>
</Base>

<style>
  .hero {
    background: var(--bg-section);
    padding: var(--space-9) 0 var(--space-7);
    border-bottom: 1px solid var(--border-soft);
  }
  .hero h1 { max-width: 22ch; margin-bottom: var(--space-4); }
  .hero__lede {
    max-width: 70ch;
    font-size: var(--fs-md);
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  .hero__lede:last-of-type { margin-bottom: 0; }

  .container > h2 { margin: var(--space-7) 0 var(--space-3); }
  .section-lede { max-width: 70ch; margin: 0 0 var(--space-6); font-size: var(--fs-md); }

  .feature-list {
    list-style: none; padding: 0; margin: 0 0 var(--space-9);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-5);
  }
  .feature {
    padding: var(--space-5) var(--space-5) var(--space-4);
    border: 1px solid var(--border-soft);
    border-left: 4px solid var(--color-gold);
    background: var(--bg-card);
  }
  .feature__eyebrow {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-navy);
    font-weight: var(--fw-medium);
    margin: 0 0 var(--space-2);
  }
  .feature h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-lg);
    line-height: 1.25;
  }
  .feature h3 a { color: var(--text-body); text-decoration: none; }
  .feature h3 a:hover { color: var(--color-navy); text-decoration: underline; }
  .feature p { margin: 0 0 var(--space-3); }
  .feature__hint { font-size: var(--fs-sm); margin-top: var(--space-2); }
  .feature__hint a { color: var(--color-navy); font-weight: var(--fw-medium); }
</style>
