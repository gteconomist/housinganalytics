---
import Base from '../layouts/Base.astro';
import manifest from '../data/generated/manifest.json';
import { fmtInt } from '../lib/format.js';

const countyCount = manifest.county_count;
const placeCount  = manifest.place_count ?? 0;
const placesVintage = manifest.places_vintage ?? 'ACS 5-year estimates';
---

<Base title="housinganalytics.org — ACS housing data for every U.S. county"
      description="County- and city-level housing data for economic-development analysts, drawn from the American Community Survey, BLS QCEW, BLS OEWS, and HUD.">

  <!-- ── Hero (EIG amber-split) ───────────────────────────── -->
  <section class="hero">
    <div class="hero__left">
      <div class="hero__leftInner">
        <p class="kicker kicker--onAmber">Housing data for economic development</p>
        <h1 class="hero__title">What can a community afford &mdash; and who can afford to live there?</h1>
        <p class="hero__lede">
          housinganalytics.org turns the American Community Survey &mdash; and the federal labor
          and housing data that go with it &mdash; into the figures, tables, and plain-language
          summaries an economic-development analyst would otherwise spend days assembling, one
          community at a time.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="/counties">Explore counties <span aria-hidden="true">&rarr;</span></a>
          <a class="btn btn--ghost-dark" href="/cities">Browse cities &amp; towns</a>
        </div>
      </div>
    </div>

    <div class="hero__right">
      <div class="hero__rightInner">
        <p class="kicker kicker--onDark">National coverage, at a glance</p>
        <div class="summary">
          <p class="summary__title">Every U.S. county &mdash; and thousands of places</p>
          <p class="summary__sub">One data set, structured like a professional housing study</p>
          <ul class="summary__rows">
            <li><span>Cities &amp; towns</span><b>{fmtInt(placeCount)}</b></li>
            <li><span>States &amp; territories</span><b>52</b></li>
            <li><span>Federal data sources</span><b>4</b></li>
          </ul>
          <div class="summary__hero">
            <span class="summary__heroLabel">Counties profiled</span>
            <span class="summary__heroNum">{fmtInt(countyCount)}</span>
          </div>
        </div>
        <div class="tiles">
          <div class="tile"><span class="tile__num">ACS 2024</span><span class="tile__label">5-year estimates</span></div>
          <div class="tile"><span class="tile__num">6 tools</span><span class="tile__label">on every profile</span></div>
          <div class="tile"><span class="tile__num">Excel · Word · PDF</span><span class="tile__label">client-ready exports</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What you can do ──────────────────────────────────── -->
  <section class="container do">
    <p class="kicker kicker--onLight">What you can do</p>
    <h2 class="do__head">Everything housinganalytics does</h2>
    <p class="section-lede muted">
      One underlying data set, surfaced six ways &mdash; each pulled into the shape an
      economic-development analyst actually needs.
    </p>

    <ol class="feature-list">
      <li class="feature">
        <span class="feature__num">01</span>
        <div class="feature__body">
          <p class="feature__eyebrow">County profiles</p>
          <h3><a href="/counties">A full housing profile for any of {fmtInt(countyCount)} counties</a></h3>
          <p>
            KPI tiles, a Community Data Summary table, tenure and stock breakdowns, value and
            rent distributions, cost-burden detail, and a parametric affordability calculator you
            adjust on the page &mdash; with BLS QCEW industry employment and wages and BLS OEWS
            occupation wages tied to affordability.
          </p>
          <p class="feature__hint"><a href="/counties">Open the county search &rarr;</a></p>
        </div>
      </li>

      <li class="feature">
        <span class="feature__num">02</span>
        <div class="feature__body">
          <p class="feature__eyebrow">City &amp; town profiles</p>
          <h3><a href="/cities">The same profile for any of {fmtInt(placeCount)} cities and towns</a></h3>
          <p>
            Demographics, housing stock, tenure, costs, rent and value distributions, cost burden,
            and the same affordability calculator at the Census place geography. HUD Area Median
            Income is inherited from the parent county. {placesVintage}.
          </p>
          <p class="feature__hint"><a href="/cities">Open the city search &rarr;</a></p>
        </div>
      </li>

      <li class="feature">
        <span class="feature__num">03</span>
        <div class="feature__body">
          <p class="feature__eyebrow">Compare</p>
          <h3><a href="/compare">Line up 2&ndash;6 counties side by side</a></h3>
          <p>
            Pick a handful of counties and see every metric from the profile next to each other
            &mdash; KPI strip, Community Data Summary, single-bar charts, and grouped or
            small-multiple distributions. The URL preserves your selection so you can share or
            bookmark a specific comparison.
          </p>
          <p class="feature__hint"><a href="/compare">Open the compare tool &rarr;</a></p>
        </div>
      </li>

      <li class="feature">
        <span class="feature__num">04</span>
        <div class="feature__body">
          <p class="feature__eyebrow">Rankings</p>
          <h3><a href="/rankings">Sort every U.S. county on any metric</a></h3>
          <p>
            Rank all {fmtInt(countyCount)} counties on any variable in the data set &mdash; median
            rent, vacancy rate, cost-burdened share, owner-occupied share, and dozens more. Filter
            by state or population tier, see the top 10 as a chart, and export the current view to CSV.
          </p>
          <p class="feature__hint"><a href="/rankings">Open the rankings explorer &rarr;</a></p>
        </div>
      </li>

      <li class="feature">
        <span class="feature__num">05</span>
        <div class="feature__body">
          <p class="feature__eyebrow">National map</p>
          <h3><a href="/map">Color every county on any metric</a></h3>
          <p>
            A choropleth of all {fmtInt(countyCount)} counties &mdash; pick a metric, zoom into a
            single state, switch between national and within-state color scales, hover for values,
            and click through to a profile. Alaska and Hawaii are inset.
          </p>
          <p class="feature__hint"><a href="/map">Open the map &rarr;</a></p>
        </div>
      </li>

      <li class="feature">
        <span class="feature__num">06</span>
        <div class="feature__body">
          <p class="feature__eyebrow">Export</p>
          <h3>Client-ready Excel, Word &amp; PDF on every profile</h3>
          <p>
            Each profile carries a download bar at the top. Pull the full data set as an Excel
            workbook, generate a formatted Word report, or save the rendered profile as a
            client-ready PDF &mdash; chart images, KPI tiles, tables, and footnotes preserved.
            Individual charts also export to PNG.
          </p>
          <p class="feature__hint muted">Look for the download bar above the KPI tiles.</p>
        </div>
      </li>
    </ol>
  </section>

  <!-- ── Data foundation ──────────────────────────────────── -->
  <section class="foundation">
    <div class="container foundation__inner">
      <div class="foundation__intro">
        <p class="kicker kicker--onLight">Built on authoritative data</p>
        <h2>Federal sources, structured like a housing study</h2>
        <p class="muted">
          Every page follows the shape of a professional housing study &mdash; a Community
          Profile, a Residential Market Analysis, and a Workforce Housing Needs Assessment
          &mdash; refreshed annually as new vintages publish.
        </p>
      </div>
      <ul class="sources">
        <li><span class="sources__tag">ACS</span> American Community Survey &mdash; 2024 5-year estimates</li>
        <li><span class="sources__tag">QCEW</span> BLS Quarterly Census of Employment &amp; Wages</li>
        <li><span class="sources__tag">OEWS</span> BLS Occupational Employment &amp; Wage Statistics</li>
        <li><span class="sources__tag">HUD</span> Area Median Income &amp; Fair Market Rents</li>
      </ul>
    </div>
  </section>

  <!-- ── Closing CTA ──────────────────────────────────────── -->
  <section class="closer">
    <div class="container closer__inner">
      <h2 class="closer__title">Start with a county.</h2>
      <p class="closer__lede">
        Search any of {fmtInt(countyCount)} counties or {fmtInt(placeCount)} cities and have a
        full housing profile in seconds.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/counties">Find a county <span aria-hidden="true">&rarr;</span></a>
        <a class="btn btn--ghost" href="/map">Open the map</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Shared ── */
  .section-lede { max-width: 68ch; margin: 0 0 var(--space-6); font-size: var(--fs-md); }

  /* EIG kicker — monospace, tracked, leading dash */
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0;
  }
  .kicker::before {
    content: "";
    width: 24px;
    height: 2px;
    background: currentColor;
    opacity: 0.7;
  }
  .kicker--onAmber { color: #ffffff; }
  .kicker--onDark  { color: var(--color-gold); }
  .kicker--onLight { color: var(--color-orange-d); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 24px;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
    letter-spacing: 0.01em;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    transition: transform 0.12s ease, background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  /* EIG primary — solid charcoal, white text */
  .btn--primary {
    color: #ffffff;
    background: var(--color-navy);
    border-color: var(--color-navy);
  }
  .btn--primary:hover { color: #ffffff; background: #23262c; }
  /* Ghost on amber — dark outline */
  .btn--ghost-dark {
    color: var(--color-navy);
    border-color: rgba(22,24,28,0.35);
    background: transparent;
  }
  .btn--ghost-dark:hover { border-color: var(--color-navy); background: rgba(22,24,28,0.06); }
  /* Ghost on dark — light outline */
  .btn--ghost {
    color: var(--text-on-dark);
    border-color: rgba(255,255,255,0.35);
    background: transparent;
  }
  .btn--ghost:hover { border-color: var(--color-gold); color: var(--color-gold); }

  /* ── Hero (EIG amber-split) ── */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .hero__left {
    background:
      radial-gradient(rgba(255,255,255,0.11) 1px, transparent 1.6px) 0 0 / 22px 22px,
      linear-gradient(150deg, #f4a63a 0%, #de8c1a 58%, #c87d1c 100%);
    padding: var(--space-9) var(--space-7);
    display: flex;
    justify-content: flex-end;
  }
  .hero__leftInner { max-width: 560px; width: 100%; }
  .hero__right {
    background: var(--color-navy);
    padding: var(--space-9) var(--space-7);
    display: flex;
    align-items: center;
  }
  .hero__rightInner { max-width: 560px; width: 100%; }

  .hero__title {
    color: #ffffff;
    font-weight: var(--fw-bold);
    font-weight: 800;
    max-width: 16ch;
    font-size: clamp(2.1rem, 3.4vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: var(--space-5) 0 var(--space-5);
  }
  .hero__lede {
    max-width: 52ch;
    font-size: var(--fs-md);
    line-height: var(--lh-base);
    color: #2a2313;
    margin-bottom: var(--space-6);
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  /* Stat summary card (dark, right) */
  .summary {
    margin-top: var(--space-5);
    background: var(--color-navy-2);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
  }
  .summary__title { color: #ffffff; font-weight: var(--fw-bold); font-size: var(--fs-md); margin: 0 0 var(--space-1); }
  .summary__sub { color: var(--color-faint); font-size: var(--fs-sm); margin: 0 0 var(--space-4); }
  .summary__rows { list-style: none; padding: 0; margin: 0; }
  .summary__rows li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    font-size: var(--fs-sm);
    color: var(--color-hair);
  }
  .summary__rows b {
    color: #ffffff;
    font-family: var(--font-mono);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }
  .summary__hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }
  .summary__heroLabel { color: var(--color-faint); font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: 0.08em; }
  .summary__heroNum {
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-weight: var(--fw-bold);
    font-size: var(--fs-2xl);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .tiles {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .tile {
    background: var(--color-navy-2);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tile__num { color: #ffffff; font-weight: var(--fw-bold); font-size: var(--fs-base); line-height: 1.15; }
  .tile__label { color: var(--color-faint); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.08em; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero__left, .hero__right { padding: var(--space-8) var(--space-6); justify-content: flex-start; }
    .hero__leftInner, .hero__rightInner { max-width: 640px; }
  }
  @media (max-width: 520px) {
    .tiles { grid-template-columns: 1fr; }
  }

  /* ── What you can do ── */
  .do { padding-top: var(--space-8); }
  .do__head { margin: var(--space-3) 0 var(--space-3); font-weight: 800; letter-spacing: -0.02em; }

  .feature-list {
    list-style: none; padding: 0; margin: 0 0 var(--space-8);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-5);
  }
  .feature {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border-soft);
    background: var(--bg-card);
    border-radius: var(--radius-md);
  }
  .feature__num {
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    color: var(--color-gold);
    line-height: 1;
    flex-shrink: 0;
  }
  .feature__eyebrow {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
    font-weight: var(--fw-semibold);
    margin: 0 0 var(--space-2);
  }
  .feature h3 { margin: 0 0 var(--space-3); font-size: var(--fs-lg); line-height: 1.25; }
  .feature h3 a { color: var(--text-primary); text-decoration: none; }
  .feature h3 a:hover { text-decoration: underline; text-decoration-color: var(--color-gold); }
  .feature p { margin: 0 0 var(--space-3); }
  .feature p:last-child { margin-bottom: 0; }
  .feature__hint { font-size: var(--fs-sm); margin-top: var(--space-2); }
  .feature__hint a { color: var(--color-navy); font-weight: var(--fw-semibold); text-decoration-color: var(--color-gold); }

  /* ── Data foundation (panel) ── */
  .foundation {
    background: var(--color-panel-2);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    padding: var(--space-8) 0;
  }
  .foundation__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  .foundation__intro h2 { margin: var(--space-3) 0 var(--space-3); font-weight: 800; letter-spacing: -0.02em; }
  .foundation__intro p { max-width: 52ch; }
  .sources { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .sources li {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-soft);
    font-size: var(--fs-sm);
    color: var(--text-body);
  }
  .sources__tag {
    font-family: var(--font-mono);
    font-weight: var(--fw-bold);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: #16181c;
    background: var(--color-gold);
    padding: 3px 8px;
    border-radius: 3px;
    flex-shrink: 0;
    min-width: 3.6em;
    text-align: center;
  }
  @media (max-width: 720px) {
    .foundation__inner { grid-template-columns: 1fr; gap: var(--space-6); }
  }

  /* ── Closing CTA (dark) ── */
  .closer {
    background: var(--color-navy);
    color: var(--text-on-dark);
    padding: var(--space-8) 0;
    margin-bottom: calc(var(--space-9) * -1);
  }
  .closer__title { color: #ffffff; font-size: var(--fs-2xl); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 var(--space-3); }
  .closer__lede { color: var(--color-hair); max-width: 56ch; font-size: var(--fs-md); margin: 0 0 var(--space-6); }
</style>
