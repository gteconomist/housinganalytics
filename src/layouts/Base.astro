---
// Base layout — site shell with brand header and footer.
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  county?: { name: string; state_name: string };
}
const { title, description, county } = Astro.props;
const fullTitle = title.includes('housinganalytics')
  ? title
  : `${title} — housinganalytics.org`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" />
</head>
<body>
  <header class="site-header">
    <div class="container site-header__inner">
      <a class="brand" href="https://economicimpact.com" target="_blank" rel="noopener" aria-label="Economic Impact Group — economicimpact.com">
        <img class="brand__logo" src="/eig-logo-white.png" alt="Economic Impact Group" width="238" height="88" />
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Home</a>

        <div class="nav-group" data-nav-group>
          <button type="button" class="nav-group__btn" aria-expanded="false" aria-haspopup="true">Explore</button>
          <div class="nav-group__menu">
            <a href="/counties">Counties</a>
            <a href="/cities">Cities</a>
          </div>
        </div>

        <div class="nav-group" data-nav-group>
          <button type="button" class="nav-group__btn" aria-expanded="false" aria-haspopup="true">Rankings</button>
          <div class="nav-group__menu">
            <a href="/rankings">County rankings</a>
            <a href="/city-rankings">City rankings</a>
          </div>
        </div>

        <div class="nav-group" data-nav-group>
          <button type="button" class="nav-group__btn" aria-expanded="false" aria-haspopup="true">Maps</button>
          <div class="nav-group__menu">
            <a href="/map">County map</a>
            <a href="/city-map">City map</a>
          </div>
        </div>

        <a href="/compare">Compare</a>
        <a href="/master-sheet">Data Sheet</a>

        <div class="nav-group" data-nav-group>
          <button type="button" class="nav-group__btn" aria-expanded="false" aria-haspopup="true">Analysis</button>
          <div class="nav-group__menu">
            <a href="/analysis">Analysis &amp; studies</a>
            <a href="/housing-gap">Housing gap</a>
          </div>
        </div>

        <a href="/about">About</a>
        <span class="site-auth" data-auth-slot></span>
      </nav>
    </div>
  </header>
  <script is:inline>
    (function () {
      var groups = Array.prototype.slice.call(document.querySelectorAll('[data-nav-group]'));
      function closeAll(except) {
        groups.forEach(function (g) {
          if (g === except) return;
          var b = g.querySelector('.nav-group__btn'); var m = g.querySelector('.nav-group__menu');
          if (b) b.setAttribute('aria-expanded', 'false');
          if (m) m.classList.remove('is-open');
        });
      }
      groups.forEach(function (g) {
        var btn = g.querySelector('.nav-group__btn');
        var menu = g.querySelector('.nav-group__menu');
        if (!btn || !menu) return;
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          var open = menu.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          closeAll(g);
        });
      });
      document.addEventListener('click', function (e) {
        if (!e.target.closest || !e.target.closest('[data-nav-group]')) closeAll(null);
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(null); });
    })();
  </script>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="site-footer__inner">
        <div class="site-footer__text">
          <p class="muted">
            Data: <a href="https://www.census.gov/programs-surveys/acs" target="_blank" rel="noreferrer">American Community Survey</a>, 2024 5-year estimates.
          </p>
          <p class="muted small">housinganalytics.org · built {new Date().getFullYear()}</p>
          <p class="muted small">A product of Economic Impact Group, LLC.</p>
        </div>
        <a class="site-footer__eig" href="https://economicimpact.com" target="_blank" rel="noreferrer" aria-label="Economic Impact Group, LLC">
          <img src="/eig-logo-dark.png" alt="Economic Impact Group, LLC" width="190" height="70" />
        </a>
      </div>
      <p class="site-footer__disclaimer muted small">
        <strong>Disclaimer.</strong> Charts and analysis are provided for informational purposes only.
        Data is pulled directly from official statistical agencies but is not independently validated by
        Economic Impact Group, LLC; please consult the original source for any decisions that depend on accuracy.
      </p>
    </div>
  </footer>

  <!-- Sign in / Sign out. Cloudflare Access exposes the signed-in identity at
       /cdn-cgi/access/get-identity and a logout URL at /cdn-cgi/access/logout.
       We ask who's logged in and show the right control on every page. -->
  <script is:inline>
    (async function () {
      const slot = document.querySelector('[data-auth-slot]');
      if (!slot) return;
      try {
        const r = await fetch('/cdn-cgi/access/get-identity', { cache: 'no-store' });
        if (!r.ok) throw new Error('not signed in');
        const id = await r.json();
        const email = id && id.email ? id.email : '';
        slot.innerHTML =
          (email ? '<span class="site-auth__who">' + email + '</span>' : '') +
          '<a class="site-auth__btn" href="/cdn-cgi/access/logout">Sign out</a>';
      } catch (e) {
        // Not authenticated (or running locally without Access) — offer sign-in.
        slot.innerHTML = '<a class="site-auth__btn" href="/counties">Sign in</a>';
      }
    })();
  </script>
</body>
</html>

<style>
  .site-header {
    background: var(--color-navy);
    color: var(--text-on-dark);
    border-bottom: 4px solid var(--color-gold);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-5);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .brand__logo {
    height: 48px;
    width: auto;
    display: block;
  }
  @media (max-width: 640px) {
    .brand__logo { height: 38px; }
  }
  .site-nav {
    display: flex;
    gap: var(--space-5);
  }
  .site-nav a {
    color: #ffffff !important;
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
  }
  .site-nav a:hover {
    border-bottom-color: var(--color-gold);
  }

  /* Grouped dropdown menus (Explore / Rankings / Maps). */
  .nav-group { position: relative; display: inline-flex; }
  .nav-group__btn {
    background: none; border: 0; cursor: pointer; font-family: inherit;
    color: #ffffff; font-size: var(--fs-sm); font-weight: var(--fw-medium);
    letter-spacing: 0.02em; padding: 0 0 2px;
    border-bottom: 2px solid transparent; display: inline-flex; align-items: center; gap: 4px;
  }
  .nav-group__btn::after { content: '\25BE'; font-size: 0.7em; opacity: 0.8; }
  .nav-group__btn:hover,
  .nav-group__btn[aria-expanded="true"] { border-bottom-color: var(--color-gold); }
  .nav-group__menu {
    position: absolute; top: 100%; left: 0; z-index: 40;
    display: none; min-width: 180px; margin-top: 8px; padding: 6px;
    background: var(--color-navy, #16181c); border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--radius-sm, 6px); box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    flex-direction: column; gap: 2px;
  }
  .nav-group:hover .nav-group__menu,
  .nav-group:focus-within .nav-group__menu,
  .nav-group__menu.is-open { display: flex; }
  .nav-group__menu a {
    color: #ffffff !important; text-decoration: none; font-size: var(--fs-sm);
    padding: 6px 10px; border-radius: 4px; border-bottom: 0 !important; white-space: nowrap;
  }
  .nav-group__menu a:hover { background: rgba(255,255,255,0.10); border-bottom-color: transparent !important; }
  /* The auth links are injected by JS (see script below), so they never get
     Astro's scoped-style marker. These rules MUST be :global() or they won't
     apply to the injected <a>/<span>. */
  :global(.site-auth) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: var(--space-3);
  }
  :global(.site-auth__who) {
    color: #cbd5e0;
    font-size: var(--fs-xs);
    max-width: 18ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.site-auth__btn) {
    color: #ffffff !important;
    text-decoration: none !important;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    border: 1.5px solid var(--color-gold) !important;
    border-radius: var(--radius-sm);
    padding: 4px 14px;
    line-height: 1.4;
    white-space: nowrap;
  }
  :global(.site-auth__btn:hover) {
    background: var(--color-gold);
    color: var(--color-navy) !important;
  }
  .site-footer {
    border-top: 1px solid var(--border-soft);
    padding: var(--space-7) 0;
    margin-top: var(--space-9);
    background: var(--bg-section);
  }
  .site-footer__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .site-footer .small { margin-top: var(--space-2); }
  .site-footer__disclaimer {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-soft);
    max-width: 90ch;
    line-height: var(--lh-base);
  }
  .site-footer__disclaimer strong { color: var(--text-primary); }
  .site-footer__eig {
    display: inline-flex;
    flex-shrink: 0;
    text-decoration: none;
    opacity: 0.92;
    transition: opacity 0.15s ease;
  }
  .site-footer__eig:hover { opacity: 1; }
  .site-footer__eig img {
    display: block;
    width: 190px;
    height: auto;
  }
  @media (max-width: 640px) {
    .site-footer__inner { align-items: flex-start; }
  }
  @media (max-width: 640px) {
    .site-header__inner { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
    .site-nav { flex-wrap: wrap; gap: var(--space-3); }
  }
</style>
