---
// Base layout — site shell with brand header and footer.
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  county?: { name: string; state_name: string };
}
const { title, description, county } = Astro.props;
const fullTitle = title.includes('housinganalytics')
  ? title
  : `${title} — housinganalytics.org`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" />
</head>
<body>
  <header class="site-header">
    <div class="container site-header__inner">
      <a class="brand" href="/" aria-label="housinganalytics.org — home">
        <img class="brand__logo" src="/eig-logo-white.png" alt="Economic Impact Group" width="238" height="88" />
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/counties">Counties</a>
        <a href="/cities">Cities</a>
        <a href="/compare">Compare</a>
        <a href="/rankings">Rankings</a>
        <a href="/map">Map</a>
        <a href="/about">About</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <div class="site-footer__text">
        <p class="muted">
          Data: <a href="https://www.census.gov/programs-surveys/acs" target="_blank" rel="noreferrer">American Community Survey</a>, 2024 5-year estimates.
        </p>
        <p class="muted small">housinganalytics.org · built {new Date().getFullYear()}</p>
        <p class="muted small">A product of Economic Impact Group, LLC.</p>
      </div>
      <a class="site-footer__eig" href="https://economicimpact.com" target="_blank" rel="noreferrer" aria-label="Economic Impact Group, LLC">
        <img src="/eig-logo-dark.png" alt="Economic Impact Group, LLC" width="190" height="70" />
      </a>
    </div>
  </footer>
</body>
</html>

<style>
  .site-header {
    background: var(--color-navy);
    color: var(--text-on-dark);
    border-bottom: 4px solid var(--color-gold);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .brand__logo {
    height: 30px;
    width: auto;
    display: block;
  }
  @media (max-width: 640px) {
    .brand__logo { height: 26px; }
  }
  .site-nav {
    display: flex;
    gap: var(--space-5);
  }
  .site-nav a {
    color: #ffffff !important;
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
  }
  .site-nav a:hover {
    border-bottom-color: var(--color-gold);
  }
  .site-footer {
    border-top: 1px solid var(--border-soft);
    padding: var(--space-7) 0;
    margin-top: var(--space-9);
    background: var(--bg-section);
  }
  .site-footer__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .site-footer .small { margin-top: var(--space-2); }
  .site-footer__eig {
    display: inline-flex;
    flex-shrink: 0;
    text-decoration: none;
    opacity: 0.92;
    transition: opacity 0.15s ease;
  }
  .site-footer__eig:hover { opacity: 1; }
  .site-footer__eig img {
    display: block;
    width: 190px;
    height: auto;
  }
  @media (max-width: 640px) {
    .site-footer__inner { align-items: flex-start; }
  }
  @media (max-width: 640px) {
    .site-header__inner { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
    .site-nav { flex-wrap: wrap; gap: var(--space-3); }
  }
</style>
