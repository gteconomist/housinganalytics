# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.astro/

# Generated data (rebuilt from spreadsheet on every build).
# Note: the Community Data Sheet generator's data lives in public/master-data/
# (NOT public/data/), is produced by `npm run master-geo`, and IS committed.
src/data/generated/
public/data/

# Cached raw Census API pull from build-places-xlsx.mjs (only useful for
# iterating on the script — the published XLSX is the source of truth)
scripts/.places-raw-cache.json

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*.textClipping
# Excel lock files (created when an .xlsx is open in Excel)
~$*.xlsx
~$*.xls

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env
.env.*

# Build preview output
preview/
